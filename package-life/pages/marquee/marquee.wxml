<view wx:if="{{!running}}" class="marquee-editor">
  <view class="marquee-custom-nav" style="height:{{navTotalHeight}}px;"><view class="marquee-custom-nav-content" style="top:{{statusBarHeight}}px;height:{{navBarHeight}}px;"><button class="marquee-nav-back" bindtap="goBack" aria-label="返回上一页"><image src="/assets/icons/back.svg" mode="aspectFit"/></button><text>手持弹幕</text></view></view>
  <view class="page tool-page marquee-page">
  <view class="page-head">
    <view class="tool-title"><text class="title">手持弹幕</text><text class="desc">全屏滚动 · 自由配色 · 醒目展示</text></view>
    <view class="tool-icon orange"><image src="/assets/icons/marquee.svg" mode="aspectFit"/></view>
  </view>
  <view class="marquee-hero"><view class="marquee-sample {{scrollAxis}}" style="background:{{background}};color:{{color}};"><text wx:if="{{scrollAxis === 'horizontal'}}" style="font-size:{{fontSize / 3}}rpx;">{{previewText}}</text><view wx:else class="marquee-preview-vertical" style="font-size:{{fontSize / 3}}rpx;"><text wx:for="{{verticalGlyphs}}" wx:key="id">{{item.value}}</text></view></view><text>适合接机、应援、活动现场和远距离文字提示</text></view>
  <view class="card marquee-panel"><view class="marquee-label-row"><text class="marquee-label">弹幕文字</text><text>{{text.length}} / 80</text></view><textarea value="{{text}}" bindinput="onInput" maxlength="80" placeholder="输入想展示的文字"/></view>
  <view class="card marquee-panel">
    <text class="marquee-label">文字颜色</text>
    <view class="marquee-colors"><button wx:for="{{colors}}" wx:key="value" data-target="color" data-value="{{item.value}}" bindtap="selectColor" class="{{color === item.value ? 'active' : ''}}" style="background:{{item.value}};" aria-label="{{item.title}}"></button><button class="marquee-custom {{pickerOpen && pickerTarget === 'color' ? 'active' : ''}}" data-target="color" bindtap="openColorPicker" aria-label="自定义文字颜色"><view style="background:{{color}};"></view><text>自定义</text></button></view>
    <text class="marquee-label marquee-next">背景颜色</text>
    <view class="marquee-colors"><button wx:for="{{backgrounds}}" wx:key="value" data-target="background" data-value="{{item.value}}" bindtap="selectColor" class="{{background === item.value ? 'active' : ''}}" style="background:{{item.value}};" aria-label="{{item.title}}"></button><button class="marquee-custom {{pickerOpen && pickerTarget === 'background' ? 'active' : ''}}" data-target="background" bindtap="openColorPicker" aria-label="自定义背景颜色"><view style="background:{{background}};"></view><text>自定义</text></button></view>
    <view wx:if="{{pickerOpen}}" class="marquee-picker"><view class="marquee-picker-head"><text>{{pickerTitle}}</text><view><view style="background:{{pickerColor}};"></view><text>{{pickerColor}}</text></view></view><view id="marqueePickerArea" class="marquee-picker-area" style="background-color:{{pickerHueColor}};" bindtouchstart="onPickerAreaTouch" catchtouchmove="onPickerAreaTouch"><view class="picker-white"></view><view class="picker-black"></view><view class="picker-dot" style="left:{{pickerAreaLeft}};top:{{pickerAreaTop}};"></view></view><view id="marqueeHueSlider" class="marquee-hue" bindtouchstart="onHueTouch" catchtouchmove="onHueTouch"><view style="left:{{hueLeft}};"></view></view><button class="marquee-picker-done" bindtap="closeColorPicker">完成取色</button></view>
  </view>
  <view class="card marquee-panel"><view class="marquee-setting-head"><text class="marquee-label">滚动速度</text><text>{{speed}} 秒 / 屏</text></view><slider min="4" max="24" step="1" value="{{speed}}" bindchange="changeSpeed" activeColor="#F28B30" backgroundColor="#E7EDF4" block-size="18"/><view class="marquee-setting-head marquee-next"><text class="marquee-label">文字大小</text><text>{{fontSize}} px</text></view><slider min="56" max="180" step="4" value="{{fontSize}}" bindchange="changeFontSize" activeColor="#F28B30" backgroundColor="#E7EDF4" block-size="18"/><text class="marquee-label marquee-next">滚动版式</text><view class="marquee-axis"><button data-value="horizontal" bindtap="selectAxis" class="{{scrollAxis === 'horizontal' ? 'active' : ''}}"><view class="axis-glyph horizontal"><view></view><view></view></view><text>横向滚动</text></button><button data-value="vertical" bindtap="selectAxis" class="{{scrollAxis === 'vertical' ? 'active' : ''}}"><view class="axis-glyph vertical"><view></view><view></view></view><text>竖向滚动</text></button></view><text class="marquee-label marquee-next">滚动方向</text><view wx:if="{{scrollAxis === 'horizontal'}}" class="marquee-directions"><button data-value="left" bindtap="selectDirection" class="{{direction === 'left' ? 'active' : ''}}">向左滚动</button><button data-value="right" bindtap="selectDirection" class="{{direction === 'right' ? 'active' : ''}}">向右滚动</button></view><view wx:else class="marquee-directions"><button data-value="up" bindtap="selectDirection" class="{{direction === 'up' ? 'active' : ''}}">向上滚动</button><button data-value="down" bindtap="selectDirection" class="{{direction === 'down' ? 'active' : ''}}">向下滚动</button></view></view>
  <button class="primary-btn marquee-main" bindtap="startDisplay">开始全屏展示</button>
  <text class="marquee-gesture-note">展示时：单击暂停或继续，双击退出</text>
  <view class="page-foot-tip"><view class="privacy-line"><image class="privacy-icon" src="/assets/icons/success.svg" mode="aspectFit"/><text class="privacy-copy">本地展示，弹幕文字不上传服务器</text></view></view>
</view>
</view>
<view wx:else class="marquee-stage" style="background:{{background}};color:{{color}};" bindtap="handleStageTap"><view class="marquee-track {{scrollAxis}} to-{{direction}} {{paused ? 'paused' : ''}}" style="animation-duration:{{speed}}s;font-size:{{fontSize}}rpx;"><text wx:if="{{scrollAxis === 'horizontal'}}">{{previewText}}</text><view wx:else class="marquee-vertical-text"><text wx:for="{{verticalGlyphs}}" wx:key="id">{{item.value}}</text></view></view><view wx:if="{{showHint || paused}}" class="marquee-touch-tip"><text>{{paused ? '已暂停' : '单击暂停'}}</text><text>双击退出</text></view></view>
