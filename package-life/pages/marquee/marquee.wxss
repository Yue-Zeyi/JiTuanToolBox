.marquee-editor { min-height: 100vh; background: #F7F9FC; }
.marquee-custom-nav { position: relative; width: 100%; background: #F7F9FC; }
.marquee-custom-nav-content { position: absolute; left: 0; right: 0; display: flex; align-items: center; justify-content: center; }
.marquee-custom-nav-content > text { color: #15233B; font-size: 32rpx; font-weight: 600; line-height: 1; }
.marquee-nav-back { position: absolute; top: 50%; left: 18rpx; display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 50%; transform: translateY(-50%); }
.marquee-nav-back image { width: 34rpx; height: 34rpx; }
.marquee-page { padding-bottom: 90rpx; }
.marquee-hero { margin-bottom: 18rpx; }
.marquee-sample { display: flex; align-items: center; justify-content: center; height: 190rpx; overflow: hidden; border-radius: 18rpx; box-shadow: 0 12rpx 28rpx rgba(24, 36, 54, .13); }
.marquee-sample text { display: block; max-width: 90%; overflow: hidden; font-weight: 800; white-space: nowrap; }
.marquee-sample.vertical { box-sizing: border-box; padding: 18rpx 40rpx; }
.marquee-preview-vertical { display: flex; flex-direction: column; align-items: center; max-height: 154rpx; overflow: hidden; line-height: 1; text-align: center; }
.marquee-preview-vertical text { display: block; flex: 0 0 auto; max-width: none; min-height: 1em; white-space: pre; }
.marquee-hero > text { display: block; margin: 12rpx 4rpx 0; color: #8594A7; font-size: 20rpx; line-height: 1.5; text-align: center; }
.marquee-panel { margin-top: 16rpx; padding: 22rpx; }
.marquee-label-row, .marquee-setting-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.marquee-label { display: block; color: #243A54; font-size: 25rpx; font-weight: 600; }
.marquee-label-row > text:last-child, .marquee-setting-head > text:last-child { color: #8A99AB; font-size: 20rpx; font-weight: 400; }
.marquee-panel textarea { box-sizing: border-box; width: 100%; height: 150rpx; margin-top: 13rpx; padding: 15rpx; border: 1rpx solid #D8E3EF; border-radius: 11rpx; background: #FFF; color: #253B55; font-size: 26rpx; line-height: 1.6; }
.marquee-colors { display: flex; flex-wrap: wrap; gap: 17rpx; margin-top: 14rpx; }
.marquee-colors > button:not(.marquee-custom) { width: 58rpx; height: 58rpx; border: 5rpx solid #FFF; border-radius: 50%; box-shadow: 0 0 0 1rpx #D1DCE8; }
.marquee-colors > button.active { box-shadow: 0 0 0 4rpx #F0A45A; }
.marquee-custom { display: flex; align-items: center; gap: 8rpx; box-sizing: border-box; height: 58rpx; padding: 0 13rpx; border: 1rpx solid #D5E0EB; border-radius: 29rpx; color: #677A91; background: #F8FAFD; font-size: 19rpx; }
.marquee-custom > view { width: 29rpx; height: 29rpx; border: 3rpx solid #FFF; border-radius: 50%; box-shadow: 0 0 0 1rpx rgba(22, 40, 61, .18); }
.marquee-next { margin-top: 22rpx; }
.marquee-picker { margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid #E8EEF4; }
.marquee-picker-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; color: #344C67; font-size: 22rpx; font-weight: 600; }
.marquee-picker-head > view { display: flex; align-items: center; gap: 8rpx; color: #6F8094; font-family: Consolas, monospace; font-size: 19rpx; font-weight: 400; }
.marquee-picker-head > view > view { width: 30rpx; height: 30rpx; border: 3rpx solid #FFF; border-radius: 8rpx; box-shadow: 0 0 0 1rpx rgba(22, 40, 61, .16); }
.marquee-picker-area { position: relative; width: 100%; height: 250rpx; overflow: hidden; border-radius: 12rpx; }
.picker-white, .picker-black { position: absolute; inset: 0; }
.picker-white { background: linear-gradient(90deg, #FFF, rgba(255, 255, 255, 0)); }
.picker-black { background: linear-gradient(0deg, #000, rgba(0, 0, 0, 0)); }
.picker-dot { position: absolute; width: 34rpx; height: 34rpx; border: 4rpx solid #FFF; border-radius: 50%; box-shadow: 0 0 0 2rpx rgba(20, 31, 45, .55), 0 3rpx 8rpx rgba(20, 31, 45, .25); transform: translate(-50%, -50%); pointer-events: none; }
.marquee-hue { position: relative; height: 30rpx; margin-top: 17rpx; border-radius: 15rpx; background: linear-gradient(90deg, #F00 0%, #FF0 16.6%, #0F0 33.3%, #0FF 50%, #00F 66.6%, #F0F 83.3%, #F00 100%); }
.marquee-hue > view { position: absolute; top: 50%; width: 38rpx; height: 38rpx; border: 4rpx solid #FFF; border-radius: 50%; box-shadow: 0 0 0 2rpx rgba(20, 31, 45, .48); transform: translate(-50%, -50%); pointer-events: none; }
.marquee-picker-done { display: flex; align-items: center; justify-content: center; width: 100%; height: 62rpx; margin-top: 18rpx; border-radius: 10rpx; color: #C66B20; background: #FFF3E8; font-size: 21rpx; }
.marquee-panel slider { margin: 12rpx 0 0; }
.marquee-axis, .marquee-directions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10rpx; margin-top: 13rpx; }
.marquee-axis button, .marquee-directions button { display: flex; align-items: center; justify-content: center; height: 66rpx; border: 1rpx solid #D8E3EF; border-radius: 10rpx; color: #6B7E94; background: #F9FBFD; font-size: 22rpx; }
.marquee-axis button { gap: 12rpx; height: 76rpx; }
.marquee-axis button.active, .marquee-directions button.active { border-color: #F0A35D; color: #C76716; background: #FFF4E8; font-weight: 600; }
.axis-glyph { display: flex; align-items: center; justify-content: center; gap: 5rpx; width: 32rpx; height: 32rpx; }
.axis-glyph view { border-radius: 4rpx; background: currentColor; opacity: .76; }
.axis-glyph.horizontal { flex-direction: column; }
.axis-glyph.horizontal view { width: 30rpx; height: 5rpx; }
.axis-glyph.vertical { flex-direction: row; }
.axis-glyph.vertical view { width: 5rpx; height: 30rpx; }
.marquee-main { width: 100%; height: 88rpx; margin-top: 18rpx; border-radius: 14rpx; background: #F28B30; }
.marquee-gesture-note { display: block; margin-top: 12rpx; color: #8998AA; font-size: 20rpx; text-align: center; }
.marquee-stage { position: fixed; inset: 0; z-index: 100; display: flex; align-items: center; overflow: hidden; }
.marquee-track { position: absolute; display: inline-flex; align-items: center; will-change: transform; font-weight: 800; line-height: 1.2; animation-timing-function: linear; animation-iteration-count: infinite; }
.marquee-track.horizontal { top: 50%; left: 0; white-space: nowrap; }
.marquee-track.vertical { top: 0; left: 50%; justify-content: center; width: auto; min-width: 1em; text-align: center; }
.marquee-vertical-text { display: flex; flex-direction: column; align-items: center; line-height: 1.05; }
.marquee-vertical-text text { display: block; flex: 0 0 auto; min-width: 1em; min-height: 1em; white-space: pre; }
.marquee-track.to-left { animation-name: marquee-left; }
.marquee-track.to-right { animation-name: marquee-right; }
.marquee-track.to-up { animation-name: marquee-up; }
.marquee-track.to-down { animation-name: marquee-down; }
.marquee-track.paused { animation-play-state: paused; }
.marquee-touch-tip { position: absolute; left: 50%; bottom: 42rpx; display: flex; gap: 16rpx; align-items: center; padding: 13rpx 22rpx; border: 1rpx solid rgba(255, 255, 255, .22); border-radius: 32rpx; color: #FFF; background: rgba(10, 15, 22, .55); font-size: 19rpx; transform: translateX(-50%); white-space: nowrap; }
.marquee-touch-tip text + text { padding-left: 16rpx; border-left: 1rpx solid rgba(255, 255, 255, .28); }

@keyframes marquee-left { from { transform: translate(100vw, -50%); } to { transform: translate(-100%, -50%); } }
@keyframes marquee-right { from { transform: translate(-100%, -50%); } to { transform: translate(100vw, -50%); } }
@keyframes marquee-up { from { transform: translate(-50%, 100vh); } to { transform: translate(-50%, -100%); } }
@keyframes marquee-down { from { transform: translate(-50%, -100%); } to { transform: translate(-50%, 100vh); } }
