.metro-page{padding-bottom:90rpx}.metro-face{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;height:390rpx;overflow:hidden}.metro-face:before{content:'';position:absolute;width:300rpx;height:300rpx;border:1rpx solid #DCEBE4;border-radius:50%;background:radial-gradient(circle,#F7FCF9 0,#EDF7F1 70%,transparent 71%)}.metro-pendulum{position:absolute;top:42rpx;left:50%;width:5rpx;height:150rpx;border-radius:5rpx;background:#35AF72;transform-origin:50% 138rpx;transform:rotate(-28deg)}.metro-pendulum.running{animation:metro-swing ease-in-out infinite alternate}.metro-pendulum view{position:absolute;bottom:0;left:-13rpx;width:31rpx;height:31rpx;border:5rpx solid #FFF;border-radius:50%;background:#218B59;box-shadow:0 4rpx 10rpx rgba(23,105,66,.2)}.metro-bpm,.metro-unit,.metro-beats{position:relative;z-index:1}.metro-bpm{margin-top:40rpx;color:#203A2E;font-family:Consolas,monospace;font-size:84rpx;font-weight:700;line-height:1}.metro-unit{margin-top:12rpx;color:#71877C;font-size:22rpx}.metro-beats{display:flex;gap:10rpx;margin-top:24rpx}.metro-beats view{width:14rpx;height:14rpx;border-radius:50%;background:#C6D7CE}.metro-beats view.active{background:#2CB06E;box-shadow:0 0 0 6rpx rgba(44,176,110,.14)}.metro-beats view.active.accent{background:#F39A3B;box-shadow:0 0 0 6rpx rgba(243,154,59,.15)}.metro-adjust{display:grid;grid-template-columns:72rpx minmax(0,1fr) 72rpx;align-items:center;gap:8rpx}.metro-adjust button{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;border:1rpx solid #D9E6DF;border-radius:50%;color:#238D5B;background:#FFF;font-size:35rpx}.metro-adjust slider{margin:0}.metro-panel{margin-top:22rpx;padding:23rpx}.metro-label-row{display:flex;align-items:center;justify-content:space-between;color:#263E32;font-size:25rpx;font-weight:600}.metro-label-row text:last-child{color:#8A9A91;font-size:19rpx;font-weight:400}.metro-signatures{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9rpx;margin-top:15rpx}.metro-signatures button{display:flex;align-items:center;justify-content:center;height:64rpx;border:1rpx solid #D9E5DF;border-radius:10rpx;color:#687D72;background:#FAFCFB;font-size:21rpx}.metro-signatures button.active{border-color:#71C99C;color:#188B55;background:#ECF8F1;font-weight:600}.metro-switch{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:18rpx;padding-top:18rpx;border-top:1rpx solid #ECF1EE}.metro-switch>view{min-width:0}.metro-switch text{display:block;color:#2E4539;font-size:23rpx}.metro-switch text+text{margin-top:5rpx;color:#8A9991;font-size:18rpx}.metro-actions{display:grid;grid-template-columns:1fr 1.15fr;gap:12rpx;margin-top:18rpx}.metro-tap,.metro-main{display:flex;flex-direction:column;align-items:center;justify-content:center;height:88rpx;border-radius:14rpx}.metro-tap{border:1rpx solid #D8E5DE;color:#3D6751;background:#FFF}.metro-tap text:first-child{font-size:23rpx;font-weight:600}.metro-tap text:last-child{margin-top:3rpx;color:#8A9A91;font-size:17rpx}.metro-main{color:#FFF;background:#25A968;font-size:28rpx;font-weight:700}.metro-main.stop{background:#D55A54}@keyframes metro-swing{from{transform:rotate(-28deg)}to{transform:rotate(28deg)}}
