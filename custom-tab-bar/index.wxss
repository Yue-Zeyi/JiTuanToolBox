:host {
  display: block;
}

.bottom-nav {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 22rpx;
  z-index: 1000;
  height: 108rpx;
  padding: 12rpx 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255, 255, 255, .98);
  border: 1rpx solid #E8EEF7;
  border-radius: 28rpx;
  box-shadow: 0 14rpx 36rpx rgba(24, 51, 92, .12);
}

.nav-item {
  flex: 1;
  height: 84rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #9AA8BB;
  font-size: 21rpx;
  line-height: 1.2;
}

.nav-item.active {
  color: #2F80ED;
  font-weight: 600;
}

.nav-icon { width: 34rpx; height: 34rpx; display: block; }
