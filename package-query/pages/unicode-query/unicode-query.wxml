<view class="page tool-page unicode-page"><view class="page-head"><view class="tool-title"><text class="title">Unicode 查询</text><text class="desc">字符码点 · UTF 编码 · HTML 实体</text></view><view class="tool-icon purple"><image src="/assets/icons/unicode-query.svg" mode="aspectFit"/></view></view><view class="card unicode-panel"><view class="unicode-head"><text>输入字符</text><text>{{characterCount}} / 50</text></view><textarea class="unicode-input" value="{{input}}" bindinput="onInput" maxlength="100" placeholder="输入文字、符号或 Emoji，最多分析 50 个字符"/><text class="unicode-note">Emoji 可能由多个 Unicode 码点组成，将逐个展示。</text><text wx:if="{{error}}" class="unicode-error">{{error}}</text></view><button class="primary-btn unicode-main" bindtap="analyze">查询字符编码</button><view class="unicode-result-head"><view><text>查询结果</text><text>{{rows.length}} 个码点</text></view><button bindtap="copyAll" disabled="{{!rows.length}}"><image src="/assets/icons/password-copy.svg" mode="aspectFit"/><text>全部复制</text></button></view><view wx:if="{{rows.length}}" class="unicode-list"><view wx:for="{{rows}}" wx:key="index" class="card unicode-card"><view class="unicode-card-head"><view class="unicode-char"><text>{{item.display}}</text><text>{{item.category}}</text></view><button data-index="{{index}}" bindtap="copyItem"><image src="/assets/icons/password-copy.svg" mode="aspectFit"/></button></view><view class="unicode-grid"><view><text>码点</text><text>{{item.codePoint}}</text></view><view><text>十进制</text><text>{{item.decimal}}</text></view><view><text>UTF-8</text><text>{{item.utf8}}</text></view><view><text>UTF-16</text><text>{{item.utf16}}</text></view><view><text>HTML 实体</text><text>{{item.html}}</text></view><view><text>JavaScript</text><text>{{item.escape}}</text></view></view></view></view><view wx:else class="card unicode-empty">输入字符后点击查询</view><button class="unicode-clear" bindtap="clearAll">清空内容</button><view class="page-foot-tip"><view class="privacy-line"><image class="privacy-icon" src="/assets/icons/success.svg" mode="aspectFit"/><text class="privacy-copy">本地查询，输入字符不上传服务器</text></view></view></view>
