.unicode-page{padding-bottom:90rpx}.unicode-panel{padding:24rpx}.unicode-head,.unicode-result-head{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.unicode-head text:first-child,.unicode-result-head>view text:first-child{color:var(--jt-navy);font-size:27rpx;font-weight:700}.unicode-head text:last-child,.unicode-result-head>view text:last-child{color:#8A9AB0;font-size:20rpx}.unicode-result-head>view{display:flex;align-items:center;gap:12rpx}.unicode-input{box-sizing:border-box;display:block;width:100%;height:220rpx;margin-top:15rpx;padding:17rpx;border:1rpx solid #D8E3EF;border-radius:12rpx;background:#FFF;color:#263B56;font-size:27rpx;line-height:1.6}.unicode-note{display:block;margin-top:11rpx;color:#8795A8;font-size:20rpx;line-height:1.5}.unicode-error{display:block;margin-top:11rpx;color:#C84444;font-size:22rpx}.unicode-main{width:100%;height:84rpx;margin-top:18rpx;border-radius:14rpx}.unicode-result-head{margin-top:26rpx}.unicode-result-head button{display:flex;align-items:center;justify-content:center;gap:7rpx;min-height:56rpx;color:#2F80ED;font-size:21rpx}.unicode-result-head button[disabled]{opacity:.4}.unicode-result-head image,.unicode-card-head button image{width:25rpx;height:25rpx}.unicode-card{margin-top:12rpx;padding:20rpx}.unicode-card-head{display:flex;align-items:center;justify-content:space-between}.unicode-char{display:flex;align-items:center;gap:12rpx;min-width:0}.unicode-char text:first-child{max-width:300rpx;overflow:hidden;color:#263B56;font-size:36rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.unicode-char text:last-child{padding:7rpx 10rpx;border-radius:8rpx;color:#6D63C8;background:#F0EDFF;font-size:18rpx}.unicode-card-head button{display:flex;align-items:center;justify-content:center;width:54rpx;height:54rpx}.unicode-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9rpx;margin-top:16rpx}.unicode-grid>view{min-width:0;padding:13rpx;border-radius:9rpx;background:#F6F8FB}.unicode-grid text{display:block;overflow-wrap:anywhere}.unicode-grid text:first-child{color:#8A9AB0;font-size:18rpx}.unicode-grid text:last-child{margin-top:5rpx;color:#3C526C;font-family:Consolas,monospace;font-size:19rpx}.unicode-empty{display:flex;align-items:center;justify-content:center;min-height:180rpx;margin-top:18rpx;color:#91A0B2;font-size:22rpx}.unicode-clear{display:flex;align-items:center;justify-content:center;width:100%;height:66rpx;margin-top:10rpx;color:#2F80ED;font-size:22rpx}@media(max-width:350px){.unicode-grid{grid-template-columns:1fr}}
