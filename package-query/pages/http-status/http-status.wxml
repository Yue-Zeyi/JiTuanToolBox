<view class="page tool-page http-page"><view class="page-head"><view class="tool-title"><text class="title">HTTP 状态码</text><text class="desc">含义说明 · 排查建议 · 快速搜索</text></view><view class="tool-icon blue"><image src="/assets/icons/http-status.svg" mode="aspectFit"/></view></view><view class="card http-search"><image src="/assets/icons/search.svg" mode="aspectFit"/><input value="{{query}}" bindinput="onSearch" placeholder="输入状态码或关键词，如 404" maxlength="30"/><button wx:if="{{query}}" bindtap="clearSearch"><image src="/assets/icons/search-clear.svg" mode="aspectFit"/></button></view><scroll-view class="http-tabs" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}"><view><button wx:for="{{groups}}" wx:key="key" class="http-tab {{group === item.key ? 'active' : ''}}" data-group="{{item.key}}" bindtap="selectGroup">{{item.title}}</button></view></scroll-view><view class="http-count">找到 {{statuses.length}} 个状态码</view><view wx:if="{{statuses.length}}" class="http-list"><view wx:for="{{statuses}}" wx:key="code" class="card http-item"><button class="http-summary" data-code="{{item.code}}" bindtap="toggle"><text class="http-code group-{{item.group}}">{{item.code}}</text><view><text class="http-title">{{item.title}}</text><text class="http-desc">{{item.description}}</text></view><image src="/assets/icons/{{expandedCode === item.code ? 'chevron-up' : 'chevron-down'}}.svg" mode="aspectFit"/></button><view wx:if="{{expandedCode === item.code}}" class="http-detail"><text class="http-advice-label">处理建议</text><text class="http-advice">{{item.advice}}</text><button data-code="{{item.code}}" bindtap="copy"><image src="/assets/icons/password-copy.svg" mode="aspectFit"/><text>复制说明</text></button></view></view></view><view wx:else class="card http-empty">没有匹配的状态码，换个关键词试试</view><view class="page-foot-tip"><view class="privacy-line"><image class="privacy-icon" src="/assets/icons/success.svg" mode="aspectFit"/><text class="privacy-copy">内置离线资料，搜索内容不上传服务器</text></view></view></view>
