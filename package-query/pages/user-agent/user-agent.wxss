.ua-page{padding-bottom:100rpx}.ua-panel,.ua-result{padding:24rpx}.ua-head,.ua-result-head{display:flex;align-items:center;justify-content:space-between;gap:12rpx;color:var(--jt-navy);font-size:27rpx;font-weight:700}.ua-head button,.ua-result-head button{display:flex;align-items:center;justify-content:center;gap:7rpx;min-height:52rpx;color:#2F80ED;font-size:21rpx;font-weight:400}.ua-result-head image{width:26rpx;height:26rpx}.ua-result-head button[disabled]{opacity:.4}.ua-input{display:block;box-sizing:border-box;width:100%;height:270rpx;margin-top:16rpx;padding:16rpx;border:1rpx solid #D8E3EF;border-radius:12rpx;background:#FFF;color:#263B56;font-size:23rpx;line-height:1.6}.ua-count{display:block;margin-top:8rpx;color:#96A4B4;font-size:19rpx;text-align:right}.ua-error{display:block;margin-top:12rpx;color:#C84444;font-size:22rpx}.ua-main{width:100%;height:84rpx;margin-top:18rpx;border-radius:14rpx}.ua-result{margin-top:18rpx}.ua-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10rpx;margin-top:16rpx}.ua-grid>view{min-width:0;padding:15rpx 14rpx;border-radius:11rpx;background:#F6F9FC}.ua-grid text{display:block;overflow-wrap:anywhere}.ua-grid text:first-child{color:#8A9AB0;font-size:19rpx}.ua-grid text:last-child{margin-top:6rpx;color:#334A64;font-size:22rpx}.ua-empty{display:block;min-height:150rpx;padding-top:60rpx;color:#91A0B2;font-size:22rpx;text-align:center}.ua-clear{display:flex;align-items:center;justify-content:center;width:100%;min-height:60rpx;margin-top:15rpx;color:#2F80ED;font-size:22rpx}
