<view class="page tool-page ua-page"><view class="page-head"><view class="tool-title"><text class="title">User-Agent 解析</text><text class="desc">识别浏览器、系统与设备信息</text></view><view class="tool-icon green"><image src="/assets/icons/user-agent.svg" mode="aspectFit"/></view></view><view class="card ua-panel"><view class="ua-head"><text>输入 User-Agent</text><button bindtap="useCurrent">填入示例</button></view><textarea class="ua-input" value="{{input}}" bindinput="onInput" maxlength="2000" placeholder="粘贴浏览器 User-Agent 字符串"/><text class="ua-count">{{input.length}} / 2000</text><text wx:if="{{error}}" class="ua-error">{{error}}</text></view><button class="primary-btn ua-main" bindtap="analyze">开始解析</button><view class="card ua-result"><view class="ua-result-head"><text>解析结果</text><button bindtap="copyResult" disabled="{{!result}}"><image src="/assets/icons/password-copy.svg" mode="aspectFit"/><text>复制</text></button></view><view wx:if="{{result}}" class="ua-grid"><view><text>浏览器</text><text>{{result.browser}} {{result.browserVersion}}</text></view><view><text>操作系统</text><text>{{result.os}} {{result.osVersion}}</text></view><view><text>设备</text><text>{{result.device}}</text></view><view><text>设备类型</text><text>{{result.deviceType}}</text></view><view><text>渲染引擎</text><text>{{result.engine}}</text></view><view><text>架构</text><text>{{result.architecture}}</text></view></view><text wx:else class="ua-empty">粘贴内容后点击解析</text><button class="ua-clear" bindtap="clearAll">清空内容</button></view><view class="page-foot-tip"><view class="privacy-line"><image class="privacy-icon" src="/assets/icons/success.svg" mode="aspectFit"/><text class="privacy-copy">本地解析，User-Agent 不上传服务器</text></view></view></view>
