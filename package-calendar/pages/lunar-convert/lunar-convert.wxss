.lunar-page { padding-bottom: 100rpx; }
.lunar-page .page-head .tool-title { min-width: 0; }
.lunar-page .page-head .tool-icon { flex: 0 0 auto; }
.lunar-tabs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10rpx; margin: 18rpx 0; padding: 6rpx; border: 1rpx solid #E1E9F3; border-radius: 12rpx; background: #EDF2F8; }
.lunar-tabs button { display: flex; align-items: center; justify-content: center; min-width: 0; height: 66rpx; border-radius: 9rpx; color: #6C7E94; font-size: 23rpx; line-height: 1; }
.lunar-tabs button.active { color: var(--jt-primary); background: #FFFFFF; box-shadow: 0 4rpx 12rpx rgba(30,76,130,.08); font-weight: 600; }
.lunar-input, .lunar-result { box-sizing: border-box; width: 100%; padding: 24rpx; overflow: hidden; }
.lunar-head { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; min-width: 0; color: var(--jt-navy); font-size: 26rpx; font-weight: 600; }
.lunar-head text:first-child { min-width: 0; }
.lunar-head text:last-child { flex: 0 0 auto; color: #8797AA; font-size: 19rpx; font-weight: 400; white-space: nowrap; }
.lunar-date-picker { display: flex; align-items: center; justify-content: space-between; height: 82rpx; margin-top: 18rpx; padding: 0 18rpx; border: 1px solid #D8E3EF; border-radius: 12rpx; background: #FFFFFF; color: #263B56; font-size: 26rpx; }
.lunar-date-picker image, .lunar-pickers image { width: 25rpx; height: 25rpx; }
.lunar-pickers { display: grid; grid-template-columns: 1.25fr 1fr 1fr; gap: 10rpx; margin-top: 18rpx; }
.lunar-pickers picker { min-width: 0; }
.lunar-pickers picker > view { box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: 5rpx; width: 100%; height: 80rpx; padding: 0 12rpx; border: 1px solid #D8E3EF; border-radius: 12rpx; background: #FFFFFF; color: #263B56; font-size: 22rpx; }
.lunar-pickers picker text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.lunar-leap { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #EDF1F6; }
.lunar-leap view { min-width: 0; }
.lunar-leap text { display: block; color: var(--jt-navy); font-size: 23rpx; }
.lunar-leap text + text { margin-top: 5rpx; color: #8A9AB0; font-size: 19rpx; }
.lunar-main { width: 100%; height: 86rpx; margin-top: 18rpx; border-radius: 14rpx; }
.lunar-error { display: block; margin-top: 14rpx; padding: 14rpx 18rpx; border-radius: 12rpx; color: #B84141; background: #FFF5F5; font-size: 22rpx; }
.lunar-result { margin-top: 18rpx; }
.lunar-date-pair { display: grid; grid-template-columns: minmax(0,1fr) 44rpx minmax(0,1fr); align-items: center; gap: 8rpx; min-width: 0; }
.lunar-date-pair > view:not(.lunar-arrow) { box-sizing: border-box; min-width: 0; width: 100%; padding: 18rpx 10rpx; border-radius: 12rpx; background: #F7F9FC; text-align: center; overflow: hidden; }
.lunar-date-pair text { display: block; color: #7D8EA3; font-size: 19rpx; }
.lunar-date-pair text + text { margin-top: 7rpx; color: var(--jt-navy); font-size: 22rpx; font-weight: 600; line-height: 1.45; }
.lunar-date-pair text + text + text { margin-top: 4rpx; color: #74869B; font-size: 19rpx; font-weight: 400; }
.lunar-arrow { color: #7B70DF; font-size: 28rpx; text-align: center; }
.lunar-details { margin-top: 20rpx; border-top: 1rpx solid #EDF1F6; }
.lunar-details view { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; min-height: 66rpx; padding: 15rpx 0; border-bottom: 1rpx solid #EDF1F6; }
.lunar-details text { color: #8392A5; font-size: 21rpx; }
.lunar-details text:last-child { flex: 1; color: #334A64; text-align: right; line-height: 1.45; }
.lunar-actions { display: grid; grid-template-columns: 1fr 1.2fr; gap: 12rpx; margin-top: 20rpx; }
.lunar-actions button { min-width: 0; width: 100%; height: 76rpx; border-radius: 13rpx; font-size: 23rpx; }
.lunar-disclaimer { display: block; margin: 14rpx 8rpx 0; color: #98A5B5; font-size: 19rpx; line-height: 1.55; text-align: center; overflow-wrap: anywhere; }
@media (max-width: 350px) {
  .lunar-head { align-items: flex-start; }
  .lunar-head text:last-child { padding-top: 4rpx; font-size: 17rpx; }
  .lunar-pickers { grid-template-columns: 1fr; }
  .lunar-pickers picker > view { height: 72rpx; }
  .lunar-date-pair { grid-template-columns: 1fr; }
  .lunar-arrow { transform: rotate(90deg); }
  .lunar-actions button { font-size: 21rpx; }
}
