<view class="page tool-page lunar-page">
  <view class="page-head"><view class="tool-title"><text class="title">农历转换</text><text class="desc">公历农历双向转换与干支查询</text></view><view class="tool-icon purple"><image src="/assets/icons/lunar-convert.svg" mode="aspectFit"/></view></view>
  <view class="lunar-tabs"><button class="{{mode === 'solar' ? 'active' : ''}}" data-mode="solar" bindtap="selectMode">公历转农历</button><button class="{{mode === 'lunar' ? 'active' : ''}}" data-mode="lunar" bindtap="selectMode">农历转公历</button></view>
  <view class="card lunar-input">
    <view class="lunar-head"><text>{{mode === 'solar' ? '选择公历日期' : '选择农历日期'}}</text><text>支持 1900–2100 年</text></view>
    <picker wx:if="{{mode === 'solar'}}" mode="date" value="{{solarDate}}" start="{{minDate}}" end="{{maxDate}}" bindchange="changeSolar"><view class="lunar-date-picker"><text>{{solarDate}}</text><image src="/assets/icons/chevron-down.svg" mode="aspectFit"/></view></picker>
    <view wx:else class="lunar-pickers"><picker range="{{years}}" range-key="label" value="{{lunarYearIndex}}" bindchange="changeYear"><view><text>{{years[lunarYearIndex].label}}</text><image src="/assets/icons/chevron-down.svg" mode="aspectFit"/></view></picker><picker range="{{months}}" range-key="label" value="{{lunarMonthIndex}}" bindchange="changeMonth"><view><text>{{months[lunarMonthIndex].label}}</text><image src="/assets/icons/chevron-down.svg" mode="aspectFit"/></view></picker><picker range="{{days}}" range-key="label" value="{{lunarDayIndex}}" bindchange="changeDay"><view><text>{{days[lunarDayIndex].label}}</text><image src="/assets/icons/chevron-down.svg" mode="aspectFit"/></view></picker></view>
    <view wx:if="{{mode === 'lunar'}}" class="lunar-leap"><view><text>闰月</text><text>{{leapLabel}}</text></view><switch checked="{{isLeap}}" disabled="{{leapMonth !== months[lunarMonthIndex].value}}" bindchange="toggleLeap" color="#2F80ED"/></view>
  </view>
  <button class="primary-btn lunar-main" bindtap="convert">开始转换</button><text wx:if="{{error}}" class="lunar-error">{{error}}</text>
  <view wx:if="{{result}}" class="card lunar-result"><view class="lunar-date-pair"><view><text>公历</text><text>{{result.solarDisplay}}</text><text>{{result.week}}</text></view><view class="lunar-arrow">⇄</view><view><text>农历</text><text>{{result.lunarDate}}</text><text>属{{result.zodiac}}</text></view></view><view class="lunar-details"><view><text>干支纪年</text><text>{{result.ganZhiYear}}年</text></view><view><text>月柱</text><text>{{result.ganZhiMonth}}</text></view><view><text>日柱</text><text>{{result.ganZhiDay}}</text></view><view><text>节气</text><text>{{result.jieQi}}</text></view><view><text>传统节日</text><text>{{result.festivals}}</text></view></view><view class="lunar-actions"><button class="secondary-btn" bindtap="copyResult">复制结果</button><button class="primary-btn" bindtap="saveRecord" loading="{{saving}}">{{saved ? '已保存记录' : '保存记录'}}</button></view><text class="lunar-disclaimer">历法信息按内置离线历法库推算，仅供日期查询。</text></view>
  <view class="page-foot-tip"><view class="privacy-line"><image class="privacy-icon" src="/assets/icons/success.svg" mode="aspectFit"/><text class="privacy-copy">本地推算，日期信息不上传服务器</text></view></view>
</view>
