.tax-page{padding-bottom:100rpx}.tax-tabs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8rpx;margin:0 0 18rpx;padding:6rpx;border:1rpx solid #E1E9F3;border-radius:12rpx;background:#EDF2F8}.tax-tab{display:flex;align-items:center;justify-content:center;height:66rpx;border-radius:9rpx;color:#6C7E94;font-size:24rpx;line-height:1}.tax-tab.active{color:var(--jt-primary);background:#FFF;box-shadow:0 4rpx 12rpx rgba(30,76,130,.08);font-weight:600}.tax-panel,.tax-result{padding:24rpx}.tax-field+.tax-field{margin-top:18rpx}.tax-field>text{display:block;margin-bottom:8rpx;color:#718096;font-size:22rpx}.tax-input,.tax-picker{display:flex;align-items:center;justify-content:space-between;gap:10rpx;box-sizing:border-box;width:100%;height:78rpx;padding:0 16rpx;border:1rpx solid #CBDCED;border-radius:11rpx;background:#FFF;color:#234666}.tax-input text{margin:0;color:#7E8FA4;font-size:25rpx}.tax-input input{flex:1;width:0;height:76rpx;color:#234666;font-family:Consolas,Monaco,monospace;font-size:27rpx}.tax-picker{font-size:25rpx}.tax-picker image{width:24rpx;height:24rpx}.tax-assumption{display:block;margin-top:16rpx;color:#8493A5;font-size:20rpx;line-height:1.55;text-align:center}.tax-error{display:block;margin-top:13rpx;color:#C84444;font-size:22rpx}.tax-main{width:100%;height:84rpx;margin-top:18rpx;border-radius:14rpx}.tax-result{margin-top:18rpx}.tax-result-head{display:flex;align-items:center;justify-content:space-between;color:var(--jt-navy);font-size:27rpx;font-weight:700}.tax-result-head button{display:flex;align-items:center;gap:7rpx;min-height:52rpx;color:#2F80ED;font-size:21rpx}.tax-result-head image{width:26rpx;height:26rpx}.tax-result-head button[disabled]{opacity:.4}.tax-result-text{display:block;min-height:130rpx;margin-top:16rpx;color:#234666;font-size:25rpx;line-height:1.75;white-space:pre-wrap;overflow-wrap:anywhere}.tax-clear{display:flex;align-items:center;justify-content:center;width:100%;min-height:60rpx;margin-top:16rpx;color:#2F80ED;font-size:22rpx}
