<view class="page tool-page password-page">
  <view class="page-head">
    <view class="tool-title"><text class="title">随机密码</text><text class="desc">自定义规则，生成专属密码</text></view>
    <view class="tool-icon blue"><image src="/assets/icons/password.svg" mode="aspectFit"/></view>
  </view>

  <view class="password-section password-size-section">
    <view class="password-number-grid">
      <view class="password-number-field">
        <text class="password-label">密码长度</text>
        <view class="password-number-box"><input type="number" value="{{length}}" bindinput="onLengthInput" maxlength="3" disabled="{{generating || saving}}" aria-label="密码长度"/><text>位</text></view>
        <text class="password-field-note">{{minLength}}-{{maxLength}} 位</text>
      </view>
      <view class="password-number-field">
        <text class="password-label">生成数量</text>
        <view class="password-number-box"><input type="number" value="{{count}}" bindinput="onCountInput" maxlength="3" disabled="{{generating || saving}}" aria-label="生成数量"/><text>条</text></view>
        <text class="password-field-note">1-{{maxCount}} 条</text>
      </view>
    </view>
    <slider class="password-slider" min="{{minLength}}" max="{{maxLength}}" step="1" value="{{length}}" bindchanging="onLengthSlide" bindchange="onLengthSlide" disabled="{{generating || saving}}" activeColor="#2F80ED" backgroundColor="#E2EAF4" block-color="#2F80ED" block-size="20" aria-label="调整密码长度"/>
  </view>

  <view class="password-section">
    <view class="password-section-head"><text class="password-label">字符类型</text><text class="password-note">至少选择 1 种</text></view>
    <view class="password-type-grid">
      <button wx:for="{{types}}" wx:key="key" class="password-type {{item.active ? 'active' : ''}}" data-key="{{item.key}}" bindtap="toggleType" disabled="{{generating || saving}}" aria-label="{{item.title}}，{{item.active ? '已选择' : '未选择'}}">
        <view class="password-check"><image wx:if="{{item.active}}" src="/assets/icons/password-check.svg" mode="aspectFit"/></view>
        <view class="password-type-copy"><text>{{item.title}}</text><text class="password-type-sample">{{item.sample}}</text></view>
      </button>
    </view>
  </view>

  <view class="password-section password-custom-section">
    <view class="password-custom-field"><view class="password-section-head"><text class="password-label">必含字符</text><text class="password-note">可选</text></view><input class="password-custom-input" value="{{include}}" bindinput="onIncludeInput" placeholder="例如：A7!" maxlength="128" disabled="{{generating || saving}}" aria-label="必含字符"/><text class="password-field-note">每个不同字符至少出现一次，可超出已选类型</text></view>
    <view class="password-custom-field"><view class="password-section-head"><text class="password-label">排除字符</text><text class="password-note">可选</text></view><input class="password-custom-input" value="{{exclude}}" bindinput="onExcludeInput" placeholder="例如：0O1lI" maxlength="128" disabled="{{generating || saving}}" aria-label="排除字符"/><text class="password-field-note">仅支持半角字母、数字和符号，不含空格</text></view>
  </view>

  <text wx:if="{{error}}" class="password-error">{{error}}</text>
  <button class="primary-btn password-generate" bindtap="generate" loading="{{generating}}" disabled="{{generating || saving}}"><image wx:if="{{!generating}}" src="/assets/icons/password-refresh.svg" mode="aspectFit"/><text>{{generating ? '正在生成' : (passwords.length ? '重新生成' : '生成密码')}}</text></button>

  <view class="password-section password-results">
    <view class="password-section-head"><text class="password-label">生成结果</text><text class="password-note">{{passwords.length}} 条<text wx:if="{{passwords.length}}"> · 每条 {{resultLength}} 位</text></text></view>
    <scroll-view wx:if="{{passwords.length}}" class="password-result-list" style="height: {{passwords.length > 1 ? 500 : (resultLength > 64 ? 300 : 160)}}rpx;" scroll-y="{{true}}">
      <view wx:for="{{passwords}}" wx:key="index" class="password-result-row">
        <text class="password-result-index">{{index + 1}}</text><text class="password-value" selectable="{{true}}">{{item}}</text>
        <button class="password-copy-one" data-index="{{index}}" bindtap="copyOne" aria-label="复制第 {{index + 1}} 条密码"><image src="/assets/icons/password-copy.svg" mode="aspectFit"/></button>
      </view>
    </scroll-view>
    <view wx:else class="password-empty"><image src="/assets/icons/password.svg" mode="aspectFit"/><text>暂无密码</text></view>
    <view class="password-result-actions">
      <button class="secondary-btn" bindtap="copyAll" disabled="{{!passwords.length}}"><image src="/assets/icons/password-copy.svg" mode="aspectFit"/><text>全部复制</text></button>
      <button class="secondary-btn" bindtap="clearResults" disabled="{{!passwords.length || generating || saving}}"><image src="/assets/icons/password-clear.svg" mode="aspectFit"/><text>清空结果</text></button>
      <button class="secondary-btn" bindtap="saveRecord" disabled="{{!passwords.length || generating || saving || saved}}" loading="{{saving}}"><image wx:if="{{!saving}}" src="/assets/icons/password-save.svg" mode="aspectFit"/><text>{{saved ? '已保存' : '保存记录'}}</text></button>
    </view>
  </view>
  <view class="page-foot-tip"><view class="privacy-line"><image class="privacy-icon" src="/assets/icons/success.svg" mode="aspectFit"/><text class="privacy-copy">本地生成，密码不上传服务器</text></view></view>
</view>
