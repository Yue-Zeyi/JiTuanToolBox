.password-page { padding-bottom: 80rpx; }
.password-section { padding: 26rpx 0; border-bottom: 1rpx solid #E1E9F3; }
.password-size-section { padding-top: 12rpx; }
.password-number-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24rpx; }
.password-number-field { min-width: 0; }
.password-label { display: block; color: var(--jt-navy); font-size: 27rpx; font-weight: 600; line-height: 1.4; }
.password-number-box { display: flex; align-items: center; height: 82rpx; margin-top: 14rpx; padding: 0 20rpx; border: 1rpx solid #D4E2F3; border-radius: 12rpx; background: #FFFFFF; }
.password-number-box input { flex: 1; min-width: 0; height: 80rpx; color: var(--jt-navy); font-size: 34rpx; font-weight: 600; }
.password-number-box > text { flex: 0 0 auto; color: #8393A8; font-size: 23rpx; }
.password-field-note { display: block; margin-top: 10rpx; color: #8595A9; font-size: 21rpx; line-height: 1.55; }
.password-slider { margin: 20rpx 8rpx 0; }
.password-section-head { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.password-note { color: #8595A9; font-size: 21rpx; line-height: 1.5; }
.password-type-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-top: 18rpx; }
.password-type { display: flex; align-items: center; gap: 14rpx; min-width: 0; min-height: 98rpx; padding: 16rpx; border: 1px solid #DCE5EF; border-radius: 12rpx; text-align: left; background: #FFFFFF; }
.password-type.active { border-color: #A3C8F8; background: #F0F7FF; }
.password-check { display: flex; align-items: center; justify-content: center; flex: 0 0 32rpx; width: 32rpx; height: 32rpx; border: 2rpx solid #B9C9DD; border-radius: 6rpx; background: #FFFFFF; }
.password-type.active .password-check { border-color: #2F80ED; background: #2F80ED; }
.password-check image { display: block; width: 26rpx; height: 26rpx; }
.password-type-copy { min-width: 0; color: var(--jt-navy); font-size: 24rpx; }
.password-type-copy > text { display: block; }
.password-type-sample { margin-top: 4rpx; color: #7A94B4; font-size: 20rpx; font-family: monospace; }
.password-custom-section { border-bottom: 0; }
.password-custom-field + .password-custom-field { margin-top: 24rpx; }
.password-custom-input { box-sizing: border-box; width: 100%; height: 78rpx; margin-top: 12rpx; padding: 0 18rpx; border: 1rpx solid #D4E2F3; border-radius: 12rpx; background: #FFFFFF; color: var(--jt-navy); font-size: 26rpx; font-family: monospace; }
.password-error { display: block; margin-bottom: 18rpx; color: #C84444; font-size: 23rpx; line-height: 1.5; }
.password-generate { width: 100%; height: 88rpx; gap: 12rpx; border-radius: 14rpx; }
.password-generate image { display: block; width: 30rpx; height: 30rpx; }
.password-results { margin-top: 10rpx; border-bottom: 0; }
.password-result-list { box-sizing: border-box; width: 100%; margin-top: 18rpx; }
.password-result-row { display: flex; align-items: flex-start; gap: 12rpx; padding: 20rpx 0; border-bottom: 1rpx solid #E3EAF3; }
.password-result-row:first-child { border-top: 1rpx solid #E3EAF3; }
.password-result-index { flex: 0 0 38rpx; padding-top: 5rpx; color: #97A7BB; font-size: 20rpx; text-align: center; }
.password-value { flex: 1; min-width: 0; padding-top: 2rpx; color: #284765; font-family: Consolas, Monaco, monospace; font-size: 27rpx; line-height: 1.6; word-break: break-all; white-space: pre-wrap; }
.password-copy-one { display: flex; align-items: center; justify-content: center; flex: 0 0 64rpx; width: 64rpx; height: 64rpx; margin-top: -8rpx; }
.password-copy-one image { display: block; width: 32rpx; height: 32rpx; }
.password-empty { display: flex; align-items: center; justify-content: center; gap: 14rpx; height: 154rpx; color: #92A1B5; font-size: 23rpx; }
.password-empty image { width: 40rpx; height: 40rpx; padding: 5rpx; border-radius: 8rpx; background: #9BB5D5; opacity: .6; }
.password-result-actions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; margin-top: 22rpx; }
.password-result-actions > button { display: flex; align-items: center; justify-content: center; gap: 7rpx; min-width: 0; height: 78rpx; padding: 0 6rpx; border-radius: 12rpx; font-size: 22rpx; white-space: nowrap; }
.password-result-actions image { flex: 0 0 26rpx; width: 26rpx; height: 26rpx; }
.password-result-actions > button[disabled] { opacity: .45; color: #607998; background: #EDF3FA; }
.password-page .page-foot-tip { margin-top: 12rpx; }
