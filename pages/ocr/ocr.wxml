<view class="page tool-page">
  <view class="page-head"><view class="tool-title"><text class="title">图片转文字</text><text class="desc">截图、照片里的文字一键提取</text></view><view class="tool-icon purple"><image src="/assets/icons/ocr.svg" mode="aspectFit"/></view></view>
  <view class="card upload-card" wx:if="{{state === 'empty' || state === 'processing'}}"><view class="upload-dash" bindtap="chooseImage"><image wx:if="{{file && file.path}}" class="preview-image" src="{{file.path}}" mode="aspectFit"/><image wx:else class="upload-plus" src="/assets/icons/add.svg" mode="aspectFit"/><text class="upload-title">{{file ? '重新选择图片' : '选择图片或拍照'}}</text><text class="upload-tip">建议使用清晰、光线均匀的图片</text></view></view>
  <view wx:if="{{state === 'empty' || state === 'processing'}}" class="primary-btn start-btn" bindtap="startOcr">{{state === 'processing' ? '正在识别…' : '开始识别'}}</view>
  <view wx:if="{{state === 'processing'}}" class="card state-card"><image class="state-mark-icon loading" src="/assets/icons/loading.svg" mode="aspectFit"/><text class="state-title">正在识别文字</text><text class="state-desc">正在分析图片内容，请稍候</text></view>
  <view wx:if="{{state === 'success'}}" class="card result-card"><view class="eyebrow">识别完成</view><view class="text-result">{{text}}</view><view class="action-row"><button class="secondary-btn" bindtap="chooseImage">重新选择</button><button class="primary-btn" bindtap="copyText">复制全部文字</button></view><view class="tips">识别结果可能存在错别字，请在使用前快速校对。</view></view>
  <view wx:if="{{state === 'error'}}" class="card state-card"><image class="state-mark-icon error" src="/assets/icons/error.svg" mode="aspectFit"/><text class="state-title">识别失败</text><text class="state-desc">{{error}}</text><button class="primary-btn" bindtap="retry">重新尝试</button></view>
  <view class="page-foot-tip"><view class="privacy-line"><image class="privacy-icon" src="/assets/icons/success.svg" mode="aspectFit"/><text class="privacy-copy">图片经微信安检后上传至识别服务</text></view><text class="privacy-detail">安检临时文件检测后删除</text></view>
  <canvas id="securityCanvas" type="2d" class="security-canvas"></canvas>
</view>
