.legal-page { padding-bottom: 80rpx; }.legal-header { padding: 10rpx 4rpx 26rpx; }.legal-title { display:block; color:var(--jt-navy); font-size:40rpx; font-weight:700; line-height:1.3; }.legal-updated { display:block; margin-top:12rpx; color:#9AA8BB; font-size:21rpx; }.legal-card { padding:28rpx 26rpx; }.legal-section { padding:2rpx 0 26rpx; }.legal-section + .legal-section { padding-top:24rpx; border-top:1rpx solid #F0F3F8; }.legal-heading { display:block; color:var(--jt-navy); font-size:28rpx; font-weight:700; line-height:1.45; }.legal-body { display:block; margin-top:12rpx; color:#53657D; font-size:24rpx; line-height:1.8; text-align:justify; }.legal-point { display:flex; align-items:flex-start; margin-top:12rpx; }.legal-bullet { flex:0 0 28rpx; color:var(--jt-primary); font-size:27rpx; line-height:1.55; }.legal-point-text { flex:1; color:#53657D; font-size:24rpx; line-height:1.8; text-align:justify; }.legal-footer { margin:30rpx 12rpx 0; color:#AEB9C8; font-size:20rpx; line-height:1.5; text-align:center; }
