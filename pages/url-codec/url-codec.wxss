.url-page { padding-bottom: 100rpx; }
.url-page .page-head .tool-title { min-width: 0; }
.url-page .page-head .tool-icon { flex: 0 0 auto; }
.url-tabs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10rpx; margin: 18rpx 0; padding: 6rpx; border: 1rpx solid #E1E9F3; border-radius: 12rpx; background: #EDF2F8; }
.url-tabs button { display: flex; align-items: center; justify-content: center; min-width: 0; height: 66rpx; border-radius: 9rpx; color: #6C7E94; font-size: 24rpx; line-height: 1; }
.url-tabs button.active { color: var(--jt-primary); background: #FFFFFF; box-shadow: 0 4rpx 12rpx rgba(30,76,130,.08); font-weight: 600; }
.url-options, .url-panel { box-sizing: border-box; width: 100%; padding: 24rpx; overflow: hidden; }
.url-option-head, .url-head { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; min-width: 0; color: var(--jt-navy); font-size: 26rpx; font-weight: 600; }
.url-option-head text:first-child, .url-head text:first-child { min-width: 0; }
.url-option-head text:last-child, .url-head text:last-child { flex: 0 0 auto; color: #8797AA; font-size: 20rpx; font-weight: 400; white-space: nowrap; }
.url-scope { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-top: 18rpx; }
.url-scope button { display: flex; flex-direction: column; justify-content: center; box-sizing: border-box; min-width: 0; width: 100%; height: 104rpx; padding: 14rpx; border: 1px solid #D8E3EF; border-radius: 12rpx; background: #FBFCFE; text-align: left; }
.url-scope text { display: block; color: var(--jt-navy); font-size: 23rpx; font-weight: 600; }
.url-scope text + text { margin-top: 6rpx; color: #8A9AB0; font-size: 18rpx; font-weight: 400; line-height: 1.3; }
.url-scope button.active { border-color: #80B2EE; background: #EEF6FF; box-shadow: inset 0 0 0 1rpx #D6E8FB; }
.url-scope button.active text:first-child { color: var(--jt-primary); }
.url-switch { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid #EEF2F7; }
.url-switch view { min-width: 0; flex: 1; }
.url-switch text { display: block; color: var(--jt-navy); font-size: 23rpx; }
.url-switch text + text { margin-top: 5rpx; color: #8A9AB0; font-size: 19rpx; }
.url-panel { margin-top: 18rpx; }
.url-input { box-sizing: border-box; display: block; width: 100%; height: 290rpx; margin-top: 16rpx; padding: 18rpx; border: 1px solid #D8E3EF; border-radius: 12rpx; background: #FFFFFF; color: #263B56; font-size: 23rpx; line-height: 1.65; overflow: hidden; }
.url-main { width: 100%; height: 86rpx; margin-top: 18rpx; border-radius: 14rpx; }
.url-error { display: block; margin-top: 14rpx; padding: 14rpx 18rpx; border-radius: 12rpx; color: #B84141; background: #FFF5F5; font-size: 22rpx; }
.url-output { box-sizing: border-box; display: block; width: 100%; max-width: 100%; height: 250rpx; margin-top: 16rpx; padding: 18rpx; border: 1rpx solid #E1E8F1; border-radius: 12rpx; background: #F8FAFD; color: #53677F; font-family: Consolas, Menlo, monospace; font-size: 23rpx; line-height: 1.65; overflow-wrap: anywhere; word-break: break-all; }
.url-output text { display: block; padding-bottom: 18rpx; }
.url-result-actions, .url-bottom { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-top: 18rpx; }
.url-result-actions button, .url-bottom button { min-width: 0; width: 100%; height: 76rpx; border-radius: 13rpx; font-size: 23rpx; }
.url-result-actions image { width: 26rpx; height: 26rpx; margin-right: 7rpx; }
.url-note { display: block; margin: 14rpx 8rpx 0; color: #8A9AB0; font-size: 20rpx; line-height: 1.55; text-align: center; overflow-wrap: anywhere; }
@media (max-width: 350px) {
  .url-option-head, .url-head { align-items: flex-start; }
  .url-option-head text:last-child, .url-head text:last-child { padding-top: 4rpx; font-size: 18rpx; }
  .url-scope { grid-template-columns: 1fr; }
  .url-scope button { height: 88rpx; }
  .url-result-actions button, .url-bottom button { font-size: 21rpx; }
}
