<view class="page tool-page url-page">
  <view class="page-head"><view class="tool-title"><text class="title">URL 编解码</text><text class="desc">网址与参数安全编码解码</text></view><view class="tool-icon orange"><image src="/assets/icons/url-codec.svg" mode="aspectFit"/></view></view>
  <view class="url-tabs"><button class="{{action === 'encode' ? 'active' : ''}}" data-action="encode" bindtap="selectAction">编码</button><button class="{{action === 'decode' ? 'active' : ''}}" data-action="decode" bindtap="selectAction">解码</button></view>
  <view class="card url-options"><view class="url-option-head"><text>处理范围</text><text>根据输入内容选择</text></view><view class="url-scope"><button class="{{scope === 'component' ? 'active' : ''}}" data-scope="component" bindtap="selectScope"><text>参数值</text><text>会编码 / ? &amp; = 等字符</text></button><button class="{{scope === 'url' ? 'active' : ''}}" data-scope="url" bindtap="selectScope"><text>完整网址</text><text>保留网址结构字符</text></button></view><view wx:if="{{action === 'decode'}}" class="url-switch"><view><text>将 + 识别为空格</text><text>适用于表单和查询参数</text></view><switch checked="{{plusAsSpace}}" bindchange="togglePlus" color="#2F80ED"/></view></view>
  <view class="card url-panel"><view class="url-head"><text>{{action === 'encode' ? '待编码内容' : '待解码内容'}}</text><text>{{inputCount}} / {{maxLength}}</text></view><textarea class="url-input" value="{{input}}" bindinput="onInput" maxlength="{{maxLength}}" placeholder="{{scope === 'url' ? '输入或粘贴完整网址' : '输入网址中的参数值或文字'}}" disable-default-padding="{{true}}" show-confirm-bar="{{false}}" cursor-spacing="24"></textarea></view>
  <button class="primary-btn url-main" bindtap="convert">{{action === 'encode' ? '开始编码' : '开始解码'}}</button>
  <text wx:if="{{error}}" class="url-error">{{error}}</text>
  <view class="card url-panel url-result"><view class="url-head"><text>转换结果</text><text>{{outputCount}} 个字符</text></view><scroll-view class="url-output" scroll-y="{{true}}"><text selectable="{{true}}">{{output || '完成转换后，结果会显示在这里'}}</text></scroll-view><view class="url-result-actions"><button class="secondary-btn" bindtap="copyResult"><image src="/assets/icons/password-copy.svg" mode="aspectFit"/><text>复制结果</text></button><button class="secondary-btn" bindtap="reverse"><image src="/assets/icons/arrow-right.svg" mode="aspectFit"/><text>反向转换</text></button></view></view>
  <view class="url-bottom"><button class="secondary-btn" bindtap="saveRecord" loading="{{saving}}">{{saved ? '已保存记录' : '保存记录'}}</button><button class="primary-btn" bindtap="clear">清空内容</button></view>
  <text class="url-note">仅点击“保存记录”后保留本次内容。</text>
  <view class="page-foot-tip"><view class="privacy-line"><image class="privacy-icon" src="/assets/icons/success.svg" mode="aspectFit"/><text class="privacy-copy">本地处理，输入内容不上传服务器</text></view></view>
</view>
