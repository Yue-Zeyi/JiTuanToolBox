<view class="page history-page">
  <view class="page-head"><view class="top-title"><text class="title">操作记录</text><text class="desc">最近 20 条 · 超出自动删除最早记录</text></view><button class="ghost-btn" wx:if="{{records.length}}" bindtap="clearHistory">清空</button></view>
  <block wx:if="{{records.length}}">
    <block wx:for="{{records}}" wx:key="id" wx:for-index="index">
      <view class="history-record card">
        <view class="record-head"><view class="mini-icon {{item.tone}}"><image src="/assets/icons/{{item.icon}}.svg" mode="aspectFit"/></view><view class="record-head-copy"><text class="record-title">{{item.title}}</text><text class="record-time">{{item.timeText}}</text></view><text class="record-count" wx:if="{{item.fileCount}}">{{item.fileCount}} 个文件</text></view>
        <view class="record-main">
          <view wx:if="{{item.previewPath || item.key === 'pdf' || item.outputFormat === 'pdf'}}" class="record-preview {{item.key === 'pdf' || item.outputFormat === 'pdf' ? 'record-preview-file' : ''}}" data-index="{{index}}" bindtap="openRecord"><image wx:if="{{item.key === 'pdf' || item.outputFormat === 'pdf'}}" src="/assets/icons/pdf.svg" mode="aspectFit"/><image wx:else src="{{item.previewPath}}" mode="aspectFill"/></view>
          <view class="record-copy">
            <view class="record-info"><text class="record-detail">{{item.detailText}}</text><text class="record-mode" wx:if="{{item.modeLabel}}">{{item.modeLabel}}</text></view>
            <view wx:if="{{item.textPreview}}" class="record-text" data-index="{{index}}" bindtap="copyRecordText"><text>{{item.textPreview}}</text><text wx:if="{{item.textTruncated}}">…</text><text class="text-action">点击复制完整文字</text></view>
          </view>
        </view>
        <view class="record-foot"><button class="record-action record-reuse" data-index="{{index}}" bindtap="reuseRecord">再次使用</button><button class="record-action record-view" data-index="{{index}}" bindtap="openRecord">查看结果<image src="/assets/icons/arrow-right.svg" mode="aspectFit"/></button></view>
      </view>
    </block>
  </block>
  <view class="card empty-history" wx:else><image class="state-mark-icon loading" src="/assets/icons/history.svg" mode="aspectFit"/><text class="state-title">还没有操作记录</text><text class="state-desc">保存过的工具操作会显示在这里，方便再次查看和使用。</text></view>
</view>
