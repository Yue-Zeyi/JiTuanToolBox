.top-title { flex: 1; }
.top-title .title { display: block; font-size: 38rpx; font-weight: 700; }
.top-title .desc { display: block; max-width: 560rpx; color: var(--jt-muted); font-size: 21rpx; line-height: 1.45; margin-top: 6rpx; }

.history-record { margin-bottom: 16rpx; padding: 18rpx 20rpx 14rpx; }
.record-head { display: flex; align-items: center; gap: 14rpx; }
.record-head-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 5rpx; }
.record-title { color: var(--jt-navy); font-size: 26rpx; font-weight: 700; }
.record-time { color: #94A3B8; font-size: 20rpx; }
.record-count { flex: 0 0 auto; color: #8A9AB0; font-size: 20rpx; }
.record-main { display: flex; align-items: stretch; gap: 16rpx; margin-top: 14rpx; }
.record-preview { position: relative; width: 112rpx; height: 112rpx; flex: 0 0 112rpx; overflow: hidden; border-radius: 12rpx; background: #F5F8FD; }
.record-preview image { width: 100%; height: 100%; display: block; }
.record-preview-file { display: flex; align-items: center; justify-content: center; background: linear-gradient(145deg, #FFB260, #F28B30); }
.record-preview-file image { width: 68rpx; height: 68rpx; }
.record-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; }
.record-info { display: flex; flex-direction: column; align-items: flex-start; gap: 7rpx; }
.record-detail { flex: 1; min-width: 0; overflow: hidden; color: var(--jt-muted); font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.record-mode { max-width: 100%; overflow: hidden; color: var(--jt-primary); font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.record-text { max-height: 94rpx; overflow: hidden; margin-top: 10rpx; padding: 10rpx 12rpx; border-radius: 10rpx; color: #52657E; background: #F8FAFD; font-size: 19rpx; line-height: 1.45; }
.text-action { display: block; margin-top: 5rpx; color: var(--jt-primary); font-size: 18rpx; }
.record-foot { display: flex; gap: 12rpx; margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx solid #F0F3F8; }
.record-action { flex: 1; height: 58rpx; display: flex; align-items: center; justify-content: center; gap: 4rpx; border-radius: 14rpx; font-size: 21rpx; line-height: 1; }
.record-reuse { border: 1rpx solid #DCE8F7; color: #617895; background: #F7FAFE; }
.record-view { color: var(--jt-primary); background: #EEF5FF; }
.record-view image { width: 24rpx; height: 24rpx; display: block; }

.empty-history { padding: 64rpx 30rpx; text-align: center; }
.empty-history .state-mark { margin-bottom: 18rpx; }
