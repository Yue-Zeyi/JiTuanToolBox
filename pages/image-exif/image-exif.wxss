.exif-page { padding-bottom: 110rpx; }
.exif-upload, .exif-info, .exif-result { padding: 24rpx; }
.exif-upload { margin-top: 0; }
.exif-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; min-height: 230rpx; border: 2rpx dashed #B8D1F3; border-radius: 16rpx; background: #F8FBFF; color: var(--jt-navy); font-size: 27rpx; font-weight: 600; }
.exif-empty image { width: 68rpx; height: 68rpx; margin-bottom: 12rpx; }
.exif-empty text + text { margin-top: 7rpx; color: #8A9AB0; font-size: 20rpx; font-weight: 400; }
.exif-file { display: flex; align-items: center; gap: 16rpx; }
.exif-file > image { flex: 0 0 126rpx; width: 126rpx; height: 126rpx; border-radius: 14rpx; background: #EDF3F8; }
.exif-file > view { flex: 1; min-width: 0; }
.exif-file text { display: block; overflow: hidden; color: var(--jt-navy); font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.exif-file text + text { margin-top: 8rpx; color: var(--jt-muted); font-size: 20rpx; }
.exif-file button { flex: 0 0 auto; font-size: 23rpx; }
.exif-info { margin-top: 18rpx; }
.exif-info-head { display: flex; align-items: center; gap: 10rpx; color: var(--jt-navy); font-size: 26rpx; font-weight: 600; }
.exif-info-head image { width: 34rpx; height: 34rpx; padding: 5rpx; border-radius: 9rpx; background: #39B978; }
.exif-tags { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; margin-top: 18rpx; }
.exif-tags text { display: flex; align-items: center; justify-content: center; min-width: 0; height: 58rpx; border-radius: 10rpx; color: #4E7A68; background: #EFF8F3; font-size: 20rpx; }
.exif-note { display: block; margin-top: 16rpx; color: #8292A6; font-size: 20rpx; line-height: 1.55; }
.exif-main { width: 100%; height: 86rpx; margin-top: 18rpx; border-radius: 14rpx; }
.exif-error { display: block; margin-top: 14rpx; color: #C84444; font-size: 22rpx; }
.exif-result { margin-top: 18rpx; }
.exif-result-head { display: flex; align-items: center; justify-content: space-between; color: var(--jt-navy); font-size: 26rpx; font-weight: 600; }
.exif-result-head text:last-child { color: #229A62; font-size: 21rpx; }
.exif-result > image { display: block; width: 100%; height: 380rpx; margin-top: 16rpx; border-radius: 14rpx; background: #F4F7FA; }
.exif-result-name { display: block; max-width: 100%; margin-top: 12rpx; overflow: hidden; color: var(--jt-navy); font-size: 22rpx; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.exif-result-meta { display: block; margin-top: 12rpx; color: var(--jt-muted); font-size: 21rpx; text-align: center; }
.exif-result-detail { display: block; margin-top: 7rpx; color: #26905D; font-size: 20rpx; text-align: center; }
.exif-actions { display: grid; grid-template-columns: 1.4fr 1fr; gap: 12rpx; margin-top: 20rpx; }
.exif-actions button { width: 100%; height: 76rpx; border-radius: 13rpx; font-size: 23rpx; }
.exif-page .page-foot-tip { margin-top: 24rpx; }
.exif-page .privacy-line { align-items: center; }
.exif-page .privacy-copy, .exif-page .privacy-detail { text-align: center; }
