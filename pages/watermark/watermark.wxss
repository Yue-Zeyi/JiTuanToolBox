.start-btn { margin-top: 24rpx; }
.single-preview { display: flex; align-items: center; min-height: 128rpx; text-align: left; }
.single-thumb { width: 112rpx; height: 112rpx; flex: 0 0 112rpx; border-radius: 16rpx; background: #EEF5FF; }
.single-info { flex: 1; min-width: 0; margin: 0 16rpx; }
.single-info .file-name { max-width: 100%; }
.single-preview .ghost-btn { flex: 0 0 auto; white-space: nowrap; }
.single-preview .file-remove { flex: 0 0 48rpx; padding: 8rpx; }
.single-preview .file-remove image { width: 30rpx; height: 30rpx; display: block; }
.panel { padding: 26rpx; margin-top: 24rpx; }
.panel-head { display: flex; align-items: center; justify-content: space-between; }
.panel-title { display: block; font-size: 27rpx; font-weight: 600; margin-bottom: 18rpx; }
.panel-title-gap { margin-top: 28rpx; }
.counter { color: #9AA8BB; font-size: 21rpx; }
.watermark-input { width: 100%; height: 76rpx; padding: 0 18rpx; border: 1rpx solid var(--jt-border); border-radius: 14rpx; background: #FBFCFE; color: var(--jt-navy); font-size: 27rpx; }
.helper { display: block; margin-top: 10rpx; color: #9AA8BB; font-size: 21rpx; }
.color-row { display: flex; align-items: center; flex-wrap: wrap; gap: 18rpx 20rpx; }
.color-chip { width: 58rpx; height: 58rpx; border-radius: 29rpx; border: 2rpx solid #DDE6F2; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 28rpx; box-shadow: 0 3rpx 10rpx rgba(24,51,92,.08); }
.color-chip.active { border-color: var(--jt-primary); box-shadow: 0 0 0 5rpx #E7F0FF; }
.color-chip:first-child { color: #2F80ED; }
.color-picker-wrap { margin-top: 20rpx; padding: 18rpx; border-radius: 16rpx; background: #F8FAFD; }
.color-picker-area { position: relative; width: 100%; height: 280rpx; overflow: hidden; border-radius: 12rpx; background: #FF0000; }
.picker-area-white, .picker-area-black { position: absolute; inset: 0; pointer-events: none; }
.picker-area-white { background: linear-gradient(90deg, #FFFFFF 0%, rgba(255,255,255,0) 100%); }
.picker-area-black { background: linear-gradient(0deg, #000000 0%, rgba(0,0,0,0) 100%); }
.picker-marker { position: absolute; width: 34rpx; height: 34rpx; border: 4rpx solid #FFFFFF; border-radius: 50%; box-shadow: 0 0 0 2rpx rgba(21,35,59,.5), 0 3rpx 8rpx rgba(21,35,59,.24); transform: translate(-50%, -50%); pointer-events: none; }
.hue-slider { position: relative; height: 30rpx; margin-top: 18rpx; border-radius: 15rpx; background: linear-gradient(90deg, #FF0000 0%, #FFFF00 16.6%, #00FF00 33.3%, #00FFFF 50%, #0000FF 66.6%, #FF00FF 83.3%, #FF0000 100%); }
.hue-marker { position: absolute; top: 50%; width: 38rpx; height: 38rpx; border: 4rpx solid #FFFFFF; border-radius: 50%; background: transparent; box-shadow: 0 0 0 2rpx rgba(21,35,59,.5), 0 3rpx 8rpx rgba(21,35,59,.24); transform: translate(-50%, -50%); pointer-events: none; }
.custom-color-row { display: flex; align-items: center; gap: 12rpx; margin-top: 18rpx; }
.custom-color-preview { width: 52rpx; height: 52rpx; flex: 0 0 52rpx; border-radius: 26rpx; border: 2rpx solid #DDE6F2; background: #FFFFFF; box-shadow: 0 3rpx 10rpx rgba(24,51,92,.08); }
.custom-color-value { color: var(--jt-navy); font-size: 25rpx; font-weight: 700; letter-spacing: .5rpx; }
.custom-color-label { margin-left: auto; color: #9AA8BB; font-size: 20rpx; }
.color-helper { display: block; margin-top: 8rpx; color: #9AA8BB; font-size: 20rpx; }
.color-error { display: block; margin-top: 8rpx; color: var(--jt-danger); font-size: 20rpx; }
.position-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10rpx; }
.position-chip { height: 62rpx; border: 1px solid var(--jt-border); border-radius: 12rpx; color: var(--jt-muted); font-size: 22rpx; display: flex; align-items: center; justify-content: center; }
.position-chip.active { color: var(--jt-primary); border-color: #8DBAF5; background: #EEF5FF; font-weight: 600; }
.slider-row { margin-top: 24rpx; }
.slider-head { display: flex; justify-content: space-between; color: var(--jt-muted); font-size: 23rpx; margin-bottom: 3rpx; }
.slider-head text:last-child { color: var(--jt-primary); font-weight: 600; }
.slider-row slider { margin: 0; }
.format-panel { margin-bottom: 2rpx; }
.choice { flex: 1; padding: 18rpx 12rpx; border-radius: 14rpx; border: 1px solid var(--jt-border); color: var(--jt-muted); text-align: center; font-size: 24rpx; }
.choice.active { color: var(--jt-primary); border-color: #8DBAF5; background: #EEF5FF; font-weight: 600; }
.choice-sub { display: block; margin-top: 5rpx; color: #92A1B6; font-size: 19rpx; font-weight: 400; }
.result-preview { width: 100%; height: 360rpx; margin: 6rpx 0 16rpx; border-radius: 16rpx; background: #F5F8FC; display: block; }
.result-text-value { max-width: 400rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.result-card .primary-btn, .result-card .secondary-btn { height: 82rpx; }
.canvas-hidden { position: fixed; left: -10000rpx; top: -10000rpx; width: 2px; height: 2px; opacity: 0; pointer-events: none; }
