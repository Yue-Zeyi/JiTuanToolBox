<view class="page tool-page watermark-page">
  <view class="page-head"><view class="tool-title"><text class="title">图片加水印</text><text class="desc">在本地为图片添加清晰可控的文字水印</text></view><view class="tool-icon purple"><image src="/assets/icons/watermark.svg" mode="aspectFit"/></view></view>

  <view class="card upload-card" wx:if="{{state === 'empty' || state === 'processing'}}"><view class="upload-dash" bindtap="chooseImage" wx:if="{{!file}}"><image class="upload-plus" src="/assets/icons/add.svg" mode="aspectFit"/><text class="upload-title">选择图片</text><text class="upload-tip">支持 JPG、PNG、WEBP 等格式 · 单张不超过 20MB</text></view><view class="single-preview" wx:if="{{file}}"><image class="single-thumb" src="{{file.path}}" mode="aspectFill" bindtap="previewImage"/><view class="single-info" bindtap="previewImage"><text class="file-name">{{file.name}}</text><text class="file-size">{{file.sizeText}} · 点击查看原图</text></view><button class="ghost-btn" bindtap="chooseImage">更换</button><button class="file-remove" bindtap="clearImage"><image src="/assets/icons/remove.svg" mode="aspectFit"/></button></view></view>

  <view class="card panel" wx:if="{{state === 'empty' || state === 'processing'}}"><view class="panel-head"><text class="panel-title">水印内容</text><text class="counter">{{text.length}}/80</text></view><input class="watermark-input" value="{{text}}" maxlength="80" bindinput="onTextInput" placeholder="输入水印文字"/><text class="helper">建议使用品牌名、账号或版权信息</text><text class="panel-title panel-title-gap">文字颜色</text><view class="color-row"><button wx:for="{{colors}}" wx:key="key" class="color-chip {{color === item.key ? 'active' : ''}}" data-color="{{item.key}}" bindtap="setColor" style="background: {{item.key}}" aria-label="{{item.title}}"><text wx:if="{{color === item.key}}">✓</text></button></view><view class="color-picker-wrap"><view id="colorPickerArea" class="color-picker-area" style="background-color: {{pickerHueColor}}" bindtouchstart="onPickerAreaTouch" catchtouchmove="onPickerAreaTouch"><view class="picker-area-white"></view><view class="picker-area-black"></view><view class="picker-marker" style="left: {{pickerAreaMarkerLeft}}; top: {{pickerAreaMarkerTop}};"></view></view><view id="colorHueSlider" class="hue-slider" bindtouchstart="onHueTouch" catchtouchmove="onHueTouch"><view class="hue-marker" style="left: {{hueMarkerLeft}};"></view></view><view class="custom-color-row"><view class="custom-color-preview" style="background: {{customColorPreview}}"></view><text class="custom-color-value">{{customColorInput}}</text><text class="custom-color-label">拖动取色器自定义</text></view></view><text class="color-helper">拖动大色板选择明暗，拖动下方色相条切换色系</text><text class="color-error" wx:if="{{colorError}}">{{colorError}}</text></view>

  <view class="card panel" wx:if="{{state === 'empty' || state === 'processing'}}"><text class="panel-title">水印位置</text><view class="position-grid"><button wx:for="{{positions}}" wx:key="key" class="position-chip {{position === item.key ? 'active' : ''}}" data-position="{{item.key}}" bindtap="setPosition">{{item.title}}</button></view><view class="slider-row"><view class="slider-head"><text>文字大小</text><text>{{fontSize}} px</text></view><slider value="{{fontSize}}" min="16" max="96" step="2" activeColor="#2F80ED" backgroundColor="#E7EDF6" bindchange="onFontSize"/></view><view class="slider-row"><view class="slider-head"><text>透明度</text><text>{{opacity}}%</text></view><slider value="{{opacity}}" min="10" max="100" step="5" activeColor="#2F80ED" backgroundColor="#E7EDF6" bindchange="onOpacity"/></view><view class="slider-row"><view class="slider-head"><text>旋转角度</text><text>{{rotate}}°</text></view><slider value="{{rotate}}" min="-45" max="45" step="1" activeColor="#2F80ED" backgroundColor="#E7EDF6" bindchange="onRotate"/></view><view class="slider-row" wx:if="{{position === 'tile'}}"><view class="slider-head"><text>平铺间距</text><text>{{spacing}} px</text></view><slider value="{{spacing}}" min="40" max="500" step="10" activeColor="#2F80ED" backgroundColor="#E7EDF6" bindchange="onSpacing"/></view></view>

  <view class="card panel format-panel" wx:if="{{state === 'empty' || state === 'processing'}}"><text class="panel-title">输出格式</text><view class="choice-row"><button class="choice {{outputFormat === 'jpg' ? 'active' : ''}}" data-format="jpg" bindtap="setOutputFormat">JPG <text class="choice-sub">适合分享</text></button><button class="choice {{outputFormat === 'png' ? 'active' : ''}}" data-format="png" bindtap="setOutputFormat">PNG <text class="choice-sub">保留透明</text></button></view></view>

  <button wx:if="{{state === 'empty' || state === 'processing'}}" class="primary-btn start-btn" bindtap="startWatermark" disabled="{{state === 'processing'}}">{{state === 'processing' ? '正在处理…' : '生成带水印图片'}}</button>
  <view wx:if="{{state === 'processing'}}" class="card state-card"><image class="state-mark-icon loading" src="/assets/icons/loading.svg" mode="aspectFit"/><text class="state-title">正在处理图片</text><text class="state-desc">水印会在本地叠加，请稍候</text></view>
  <view wx:if="{{state === 'success'}}" class="card result-card"><image class="state-mark-icon success" src="/assets/icons/success.svg" mode="aspectFit"/><text class="state-title">水印已添加</text><text class="state-desc">{{result.width}} × {{result.height}} px · {{result.sizeText}}</text><image class="result-preview" src="{{result.outputPath}}" mode="aspectFit" bindtap="previewResult"/><view class="result-row"><text class="result-label">水印文字</text><text class="result-value result-text-value">{{result.text}}</text></view><view class="action-row"><button class="secondary-btn" bindtap="chooseAgain">继续处理</button><button class="primary-btn" bindtap="saveResult">保存图片</button></view></view>
  <view wx:if="{{state === 'error'}}" class="card state-card"><image class="state-mark-icon error" src="/assets/icons/error.svg" mode="aspectFit"/><text class="state-title">处理失败</text><text class="state-desc">{{error}}</text><view class="action-row"><button class="secondary-btn" bindtap="chooseAgain">重新选择</button><button class="primary-btn" bindtap="retry">再次尝试</button></view></view>
  <view class="page-foot-tip"><view class="privacy-line"><image class="privacy-icon" src="/assets/icons/success.svg" mode="aspectFit"/><text class="privacy-copy">本地处理，图片临时上传微信安检</text></view><text class="privacy-detail">检测后删除云端临时文件</text></view>
  <canvas type="2d" id="watermarkCanvas" class="canvas-hidden"></canvas>
  <canvas id="securityCanvas" type="2d" class="security-canvas"></canvas>
</view>
