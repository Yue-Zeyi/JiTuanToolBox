.base64-page { padding-bottom: 100rpx; }
.base64-page .page-head .tool-title { min-width: 0; }
.base64-page .page-head .tool-icon { flex: 0 0 auto; }
.base64-tabs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10rpx; margin: 18rpx 0; padding: 6rpx; border: 1rpx solid #E1E9F3; border-radius: 12rpx; background: #EDF2F8; }
.base64-tabs button { display: flex; align-items: center; justify-content: center; min-width: 0; height: 66rpx; border-radius: 9rpx; color: #6C7E94; font-size: 24rpx; line-height: 1; }
.base64-tabs button.active { color: var(--jt-primary); background: #FFFFFF; box-shadow: 0 4rpx 12rpx rgba(30, 76, 130, .08); font-weight: 600; }
.base64-panel { box-sizing: border-box; width: 100%; padding: 24rpx; overflow: hidden; }
.base64-head { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; min-width: 0; color: var(--jt-navy); font-size: 26rpx; font-weight: 600; }
.base64-head text:first-child { min-width: 0; }
.base64-head text:last-child { flex: 0 0 auto; color: #8797AA; font-size: 20rpx; font-weight: 400; white-space: nowrap; }
.base64-input { box-sizing: border-box; display: block; width: 100%; height: 330rpx; margin-top: 16rpx; padding: 18rpx; border: 1px solid #D8E3EF; border-radius: 12rpx; background: #FFFFFF; color: #263B56; font-family: Consolas, Menlo, monospace; font-size: 23rpx; line-height: 1.65; overflow: hidden; }
.base64-main { width: 100%; height: 86rpx; margin-top: 18rpx; border-radius: 14rpx; }
.base64-error { display: block; margin-top: 14rpx; padding: 14rpx 18rpx; border-radius: 12rpx; color: #B84141; background: #FFF5F5; font-size: 22rpx; line-height: 1.5; }
.base64-result { margin-top: 18rpx; }
.base64-output { box-sizing: border-box; display: block; width: 100%; max-width: 100%; height: 270rpx; margin-top: 16rpx; padding: 18rpx; border: 1rpx solid #E1E8F1; border-radius: 12rpx; background: #F8FAFD; color: #53677F; font-family: Consolas, Menlo, monospace; font-size: 23rpx; line-height: 1.65; overflow-wrap: anywhere; word-break: break-all; }
.base64-output text { display: block; padding-bottom: 18rpx; }
.base64-actions, .base64-bottom { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-top: 18rpx; }
.base64-actions button, .base64-bottom button { min-width: 0; width: 100%; height: 76rpx; border-radius: 13rpx; font-size: 23rpx; }
.base64-actions image { width: 26rpx; height: 26rpx; margin-right: 7rpx; }
.base64-bottom { margin-top: 20rpx; }
.base64-note { display: block; margin: 14rpx 8rpx 0; color: #8A9AB0; font-size: 20rpx; line-height: 1.55; text-align: center; overflow-wrap: anywhere; }
@media (max-width: 350px) {
  .base64-head { align-items: flex-start; }
  .base64-head text:last-child { padding-top: 4rpx; font-size: 18rpx; }
  .base64-actions button, .base64-bottom button { font-size: 21rpx; }
}
