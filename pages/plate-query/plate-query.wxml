<view class="page tool-page plate-page">
  <view class="page-head"><view class="tool-title"><text class="title">车牌号查询</text><text class="desc">校验号牌格式与省级归属</text></view><view class="tool-icon blue"><image src="/assets/icons/plate-query.svg" mode="aspectFit"/></view></view>
  <view class="card plate-input-panel"><view class="plate-head"><text>输入车牌号</text><text>自动忽略空格与分隔符</text></view><view class="plate-input"><view>{{inputPrefix}}</view><input value="{{input}}" bindinput="onInput" maxlength="8" placeholder="例如：京A12345" confirm-type="search" bindconfirm="query"/></view><view class="plate-examples"><button wx:for="{{examples}}" wx:key="plate" data-index="{{index}}" bindtap="chooseExample"><text>{{item.plate}}</text><text>{{item.label}}</text></button></view></view>
  <button class="primary-btn plate-main" bindtap="query">查询车牌号</button><text wx:if="{{error}}" class="plate-error">{{error}}</text>
  <view wx:if="{{result}}" class="card plate-result"><view class="plate-visual {{result.tone}}"><text>{{result.prefix}}</text><view class="plate-dot"></view><text>{{result.serial}}</text></view><view class="plate-valid"><image src="/assets/icons/success.svg" mode="aspectFit"/><text>号牌格式符合规则</text></view><view class="plate-details"><view><text>号牌类型</text><text>{{result.typeLabel}}</text></view><view><text>省级归属</text><text>{{result.provinceName}}</text></view><view><text>机关代码</text><text>{{result.agencyCode}}</text></view><view><text>号牌序号</text><text>{{result.serial}}</text></view><view wx:if="{{result.energy}}"><text>能源类型</text><text>{{result.energy}}</text></view></view><text class="plate-note">{{result.note}}</text><view class="plate-actions"><button class="secondary-btn" bindtap="copyPlate">复制车牌号</button><button class="primary-btn" bindtap="saveRecord" loading="{{saving}}">{{saved ? '已保存记录' : '保存记录'}}</button></view></view>
  <button class="plate-clear" bindtap="clear">清空查询</button>
  <text class="plate-disclaimer">本工具仅按现行常见号牌编排规则校验格式，不连接车管数据库，不提供车主、车辆或违章信息。</text>
  <view class="page-foot-tip"><view class="privacy-line"><image class="privacy-icon" src="/assets/icons/success.svg" mode="aspectFit"/><text class="privacy-copy">本地查询，车牌内容不上传服务器</text></view></view>
</view>
