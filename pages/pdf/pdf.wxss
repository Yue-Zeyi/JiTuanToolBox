.start-btn { margin-top: 24rpx; }
.selection-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 24rpx 0 12rpx; }
.selection-head > view { flex: 1; min-width: 0; }
.selection-title { display: block; font-size: 27rpx; font-weight: 700; }
.selection-tip { display: block; color: var(--jt-muted); font-size: 21rpx; margin-top: 5rpx; }
.file-item { padding: 12rpx 10rpx; min-height: 94rpx; }
.file-order { width: 38rpx; height: 38rpx; flex: 0 0 38rpx; border-radius: 19rpx; display: flex; align-items: center; justify-content: center; color: #5B82B8; background: #EAF2FF; font-size: 21rpx; font-weight: 700; }
.file-thumb { width: 72rpx; height: 72rpx; margin-left: 10rpx; }
.file-sort { flex: 0 0 44rpx; display: flex; flex-direction: column; align-items: center; gap: 2rpx; }
.sort-btn { width: 42rpx; height: 32rpx; display: flex; align-items: center; justify-content: center; opacity: 1; }
.sort-btn[disabled] { opacity: .25; }
.sort-btn image { width: 24rpx; height: 24rpx; display: block; }
.file-remove { padding: 8rpx; }
.file-remove image { width: 30rpx; height: 30rpx; display: block; }
.panel { padding: 26rpx; margin-top: 24rpx; }
.panel-title { display: block; font-size: 27rpx; font-weight: 600; margin-bottom: 18rpx; }
.panel-title-gap { margin-top: 28rpx; }
.size-choice-row { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10rpx; }
.choice { min-width: 0; padding: 17rpx 6rpx; border-radius: 14rpx; border: 1px solid var(--jt-border); text-align: center; color: var(--jt-muted); font-size: 23rpx; line-height: 1.25; }
.choice.active { color: var(--jt-primary); border-color: #8DBAF5; background: #EEF5FF; font-weight: 600; }
.choice-sub { display: block; margin-top: 5rpx; color: #92A1B6; font-size: 18rpx; font-weight: 400; white-space: nowrap; transform: scale(.9); }
.choice.active .choice-sub { color: #6D9FDD; }
.custom-size { display: flex; align-items: center; justify-content: center; gap: 12rpx; margin-top: 18rpx; color: var(--jt-muted); font-size: 25rpx; }
.custom-input { width: 150rpx; height: 68rpx; padding: 0 16rpx; border: 1rpx solid var(--jt-border); border-radius: 12rpx; background: #FBFCFE; color: var(--jt-navy); font-size: 26rpx; text-align: center; }
.unit-label { font-size: 22rpx; }
.tool-progress { display: block; width: 100%; margin: 22rpx 0 12rpx; }
.progress-tip { display: block; color: var(--jt-muted); font-size: 22rpx; }
.result-file-name { max-width: 420rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.result-success-mark { margin-bottom: 4rpx; }
.result-card .primary-btn, .result-card .secondary-btn { height: 82rpx; }
.pdf-open-tip { margin-top: 20rpx; padding: 16rpx 18rpx; border-radius: 14rpx; color: #5E789A; background: #F3F8FF; font-size: 21rpx; line-height: 1.55; }
.canvas-hidden { position: fixed; left: -10000rpx; top: -10000rpx; width: 2px; height: 2px; opacity: 0; pointer-events: none; }
