<view class="page tool-page pdf-page">
  <view class="page-head"><view class="tool-title"><text class="title">图片转 PDF</text><text class="desc">把多张图片整理成一个 PDF 文件</text></view><view class="tool-icon orange"><image src="/assets/icons/pdf.svg" mode="aspectFit"/></view></view>

  <view class="card upload-card" wx:if="{{state === 'empty' || state === 'processing'}}">
    <view class="upload-dash" bindtap="chooseImages"><image class="upload-plus" src="/assets/icons/add.svg" mode="aspectFit"/><text class="upload-title">选择图片</text><text class="upload-tip">按当前顺序生成 PDF · 最多 {{maxFiles}} 张 · 单张不超过 20MB</text></view>
    <view class="selection-head" wx:if="{{files.length}}"><view><text class="selection-title">已选 {{files.length}} 张</text><text class="selection-tip">点击缩略图查看原图，使用箭头调整顺序</text></view><button class="ghost-btn" bindtap="clearFiles">清空</button></view>
    <view class="file-list" wx:if="{{files.length}}"><block wx:for="{{files}}" wx:key="path" wx:for-index="index"><view class="file-item"><view class="file-order"><text>{{index + 1}}</text></view><image class="file-thumb" src="{{item.path}}" mode="aspectFill" bindtap="previewImage" data-index="{{index}}"/><view class="file-info" bindtap="previewImage" data-index="{{index}}"><text class="file-name">{{item.name}}</text><text class="file-size">{{item.sizeText}}</text></view><view class="file-sort"><button class="sort-btn" data-index="{{index}}" data-delta="-1" bindtap="moveFile" disabled="{{index === 0}}"><image src="/assets/icons/chevron-up.svg" mode="aspectFit"/></button><button class="sort-btn" data-index="{{index}}" data-delta="1" bindtap="moveFile" disabled="{{index === files.length - 1}}"><image src="/assets/icons/chevron-down.svg" mode="aspectFit"/></button></view><button class="file-remove" data-index="{{index}}" catchtap="removeFile"><image src="/assets/icons/remove.svg" mode="aspectFit"/></button></view></block></view>
  </view>

  <view class="card panel" wx:if="{{state === 'empty' || state === 'processing'}}"><text class="panel-title">页面尺寸</text><view class="choice-row size-choice-row"><button wx:for="{{pageSizes}}" wx:key="key" class="choice {{pageSize === item.key ? 'active' : ''}}" data-value="{{item.key}}" bindtap="setPageSize"><text>{{item.title}}</text><text class="choice-sub">{{item.desc}}</text></button></view><view class="custom-size" wx:if="{{pageSize === 'custom'}}"><input class="custom-input" type="digit" value="{{customWidth}}" bindinput="onCustomWidth" maxlength="6"/><text>×</text><input class="custom-input" type="digit" value="{{customHeight}}" bindinput="onCustomHeight" maxlength="6"/><text class="unit-label">mm</text></view></view>
  <view class="card panel" wx:if="{{state === 'empty' || state === 'processing'}}"><text class="panel-title">页面方向</text><view class="choice-row"><button wx:for="{{orientations}}" wx:key="key" class="choice {{orientation === item.key ? 'active' : ''}}" data-value="{{item.key}}" bindtap="setOrientation">{{item.title}}</button></view><text class="panel-title panel-title-gap">图片适配</text><view class="choice-row"><button wx:for="{{fits}}" wx:key="key" class="choice {{fit === item.key ? 'active' : ''}}" data-value="{{item.key}}" bindtap="setFit"><text>{{item.title}}</text><text class="choice-sub">{{item.desc}}</text></button></view><text class="panel-title panel-title-gap">页边距</text><view class="choice-row"><button wx:for="{{margins}}" wx:key="key" class="choice {{margin === item.key ? 'active' : ''}}" data-value="{{item.key}}" bindtap="setMargin">{{item.title}}</button></view></view>

  <button wx:if="{{state === 'empty' || state === 'processing'}}" class="primary-btn start-btn" bindtap="startPdf" disabled="{{state === 'processing'}}">{{state === 'processing' ? '正在生成 PDF…' : '生成 PDF'}}</button>
  <view wx:if="{{state === 'processing'}}" class="card state-card"><image class="state-mark-icon loading" src="/assets/icons/loading.svg" mode="aspectFit"/><text class="state-title">正在生成 PDF</text><text class="state-desc">{{currentStep}} · 已完成 {{progress}}%</text><progress class="tool-progress" percent="{{progress}}" activeColor="#2F80ED" backgroundColor="#E8EEF7" stroke-width="6"/><text class="progress-tip">图片会在本地逐页整理，请不要关闭页面</text></view>
  <view wx:if="{{state === 'success'}}" class="card result-card"><view class="result-success-mark"><image class="state-mark-icon success" src="/assets/icons/success.svg" mode="aspectFit"/></view><text class="state-title">PDF 已生成</text><text class="state-desc">{{result.pageCount}} 页 · {{result.sizeText}}</text><view class="result-row"><text class="result-label">文件名</text><text class="result-value result-file-name">{{result.name}}</text></view><view class="result-row"><text class="result-label">页面设置</text><text class="result-value">{{result.pageSize === 'auto' ? '自动适配' : result.pageSize}}</text></view><view class="pdf-open-tip">点击“打开 PDF”查看文件，随后点击右上角“···”即可转发给好友或保存到文件。</view><view class="action-row"><button class="secondary-btn" bindtap="chooseAgain">继续制作</button><button class="primary-btn" bindtap="savePdf">打开 PDF</button></view></view>
  <view wx:if="{{state === 'error'}}" class="card state-card"><image class="state-mark-icon error" src="/assets/icons/error.svg" mode="aspectFit"/><text class="state-title">生成失败</text><text class="state-desc">{{error}}</text><view class="action-row"><button class="secondary-btn" bindtap="chooseAgain">重新选择</button><button class="primary-btn" bindtap="retry">再次尝试</button></view></view>
  <view class="page-foot-tip"><view class="privacy-line"><image class="privacy-icon" src="/assets/icons/success.svg" mode="aspectFit"/><text class="privacy-copy">本地处理，图片临时上传微信安检</text></view><text class="privacy-detail">检测后删除云端临时文件</text></view>
  <canvas type="2d" id="pdfCanvas" class="canvas-hidden"></canvas>
  <canvas id="securityCanvas" type="2d" class="security-canvas"></canvas>
</view>
