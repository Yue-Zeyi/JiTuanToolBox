.mask-page{padding-bottom:120rpx}.mask-upload{min-height:360rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#60758F}.mask-upload image{width:78rpx;height:78rpx;margin-bottom:18rpx}.mask-upload text:first-of-type{font-size:28rpx;font-weight:700;color:var(--jt-navy)}.mask-upload text:last-of-type{margin-top:10rpx;color:#8A9AB0;font-size:21rpx;text-align:center}.mask-workspace,.mask-restored{padding:22rpx;margin-top:2rpx}.mask-workspace-head{display:flex;align-items:center;justify-content:space-between;gap:14rpx}.mask-workspace-head>view{min-width:0}.panel-title{display:block;color:var(--jt-navy);font-size:28rpx;font-weight:700}.panel-subtitle{display:block;margin-top:6rpx;color:#8A9AB0;font-size:20rpx;line-height:1.4}.mask-rechoose{flex:0 0 auto;min-height:58rpx;padding:0 16rpx;border-radius:12rpx;color:var(--jt-primary);background:#EEF5FF;font-size:21rpx;display:flex;align-items:center;justify-content:center}.mask-canvas{display:block;width:100%;margin-top:18rpx;border-radius:16rpx;background:#F5F8FC}.mask-mode-row{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin-top:20rpx;color:#60758F;font-size:22rpx}.mask-mode-options{display:flex;gap:8rpx}.mask-mode{height:62rpx;padding:0 16rpx;border:1rpx solid #DCE6F1;border-radius:11rpx;color:#718096;background:#fff;font-size:21rpx;display:flex;align-items:center;justify-content:center}.mask-mode.active{border-color:#8DBAF5;color:#216FCB;background:#EEF5FF;font-weight:600}.mask-help{margin-top:12rpx;color:#9AA8B0;font-size:19rpx;line-height:1.45;text-align:center}.mask-actions{display:flex;gap:12rpx;margin-top:18rpx}.mask-actions button{flex:1;height:70rpx}.mask-export{width:100%;height:78rpx;margin-top:14rpx}.mask-restored-image{display:block;width:100%;height:360rpx;margin-top:18rpx;border-radius:14rpx;background:#F5F8FC}.mask-restored button{width:100%;height:72rpx;margin-top:14rpx}.mask-result{margin-top:22rpx;padding:22rpx;border-top:1rpx solid #EDF1F6}.mask-result image{display:block;width:100%;height:360rpx;margin-top:14rpx;border-radius:14rpx;background:#F5F8FC}.mask-result button{width:100%;height:72rpx;margin-top:14rpx}.mask-error{margin-top:16rpx;color:#C84F4F;font-size:22rpx;text-align:center}
