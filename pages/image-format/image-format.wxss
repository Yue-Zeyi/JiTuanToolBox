.format-page { padding-bottom: 110rpx; }
.format-upload, .format-settings, .format-result { padding: 24rpx; }
.format-upload { margin-top: 0; }
.format-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; min-height: 236rpx; border: 2rpx dashed #B8D1F3; border-radius: 16rpx; background: #F8FBFF; }
.format-empty image { width: 70rpx; height: 70rpx; margin-bottom: 14rpx; }
.format-empty-title { color: var(--jt-navy); font-size: 27rpx; font-weight: 600; }
.format-empty-tip { margin-top: 8rpx; color: #8A9AB0; font-size: 20rpx; }
.format-file { display: flex; align-items: center; gap: 16rpx; }
.format-thumb { flex: 0 0 126rpx; width: 126rpx; height: 126rpx; border-radius: 14rpx; background: #EDF3FA; }
.format-file-copy { flex: 1; min-width: 0; }
.format-file-name { display: block; overflow: hidden; color: var(--jt-navy); font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.format-file-meta { display: block; margin-top: 8rpx; color: var(--jt-muted); font-size: 20rpx; }
.format-change { flex: 0 0 auto; font-size: 23rpx; }
.format-settings { margin-top: 18rpx; }
.format-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.format-label { color: var(--jt-navy); font-size: 26rpx; font-weight: 600; }
.format-caption { color: #8A9AB0; font-size: 20rpx; }
.format-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-top: 18rpx; }
.format-option { display: flex; flex-direction: column; justify-content: center; min-width: 0; height: 106rpx; padding: 14rpx; border: 1px solid #D8E3EF; border-radius: 12rpx; background: #FBFCFE; text-align: left; }
.format-option text { display: block; color: var(--jt-navy); font-size: 24rpx; font-weight: 600; }
.format-option text + text { margin-top: 7rpx; color: #8A9AB0; font-size: 19rpx; font-weight: 400; }
.format-option.active { border-color: #7FAFEA; background: #EEF5FF; box-shadow: inset 0 0 0 1rpx #D2E5FB; }
.format-option.active text:first-child { color: var(--jt-primary); }
.format-quality { margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid #EEF2F7; }
.format-value, .format-done { color: var(--jt-primary); font-size: 22rpx; font-weight: 600; }
.format-quality slider { margin: 16rpx 0 0; }
.format-main { width: 100%; height: 86rpx; margin-top: 18rpx; border-radius: 14rpx; }
.format-error { display: block; margin-top: 14rpx; color: #C84444; font-size: 22rpx; }
.format-result { margin-top: 18rpx; }
.format-result-image { display: block; width: 100%; height: 390rpx; margin-top: 18rpx; border-radius: 14rpx; background: #F6F8FB; }
.format-result-name { display: block; max-width: 100%; margin-top: 12rpx; overflow: hidden; color: var(--jt-navy); font-size: 22rpx; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.format-result-meta { display: block; margin-top: 12rpx; color: var(--jt-muted); font-size: 21rpx; text-align: center; }
.format-actions { display: grid; grid-template-columns: 1.4fr 1fr; gap: 12rpx; margin-top: 20rpx; }
.format-actions button { width: 100%; height: 76rpx; border-radius: 13rpx; font-size: 23rpx; }
.hidden-canvas { position: fixed; left: -10000rpx; top: -10000rpx; width: 1px; height: 1px; opacity: 0; pointer-events: none; }

.format-page .page-foot-tip { margin-top: 24rpx; }
.format-page .privacy-line { align-items: center; }
.format-page .privacy-copy, .format-page .privacy-detail { text-align: center; }
