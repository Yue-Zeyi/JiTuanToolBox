.quality-row { margin-top: 28rpx; }.quality-head { display: flex; justify-content: space-between; margin-bottom: 6rpx; color: var(--jt-muted); font-size: 24rpx; }.start-btn { margin-top: 24rpx; }.choice-row { gap: 10rpx; }.choice { padding-left: 6rpx; padding-right: 6rpx; font-size: 23rpx; }.choice-sub { color: var(--jt-primary); font-size: 20rpx; }.mode-tip { margin-top: 18rpx; padding: 16rpx 18rpx; border-radius: 14rpx; color: #52749F; background: #F4F8FE; font-size: 22rpx; line-height: 1.55; }.target-row { margin-top: 28rpx; }.target-list { display: flex; gap: 12rpx; margin-top: 16rpx; }.target-chip { flex: 1; padding: 16rpx 8rpx; border: 1px solid var(--jt-border); border-radius: 12rpx; color: var(--jt-muted); font-size: 23rpx; }.target-chip.active, .target-custom-toggle.active { color: var(--jt-primary); border-color: #8DBAF5; background: #EEF5FF; font-weight: 600; }.target-custom-toggle { width: 100%; margin-top: 12rpx; padding: 16rpx 8rpx; border: 1px dashed #B9CBE3; border-radius: 12rpx; color: var(--jt-muted); font-size: 23rpx; text-align: center; }.target-custom-editor { display: flex; align-items: center; gap: 12rpx; margin-top: 14rpx; }.target-input-wrap { flex: 1; height: 72rpx; display: flex; align-items: center; padding: 0 18rpx; border: 1rpx solid var(--jt-border); border-radius: 12rpx; background: #FBFCFE; }.target-input { flex: 1; min-width: 0; height: 72rpx; color: var(--jt-navy); font-size: 26rpx; }.target-unit-label { margin-left: 8rpx; color: var(--jt-muted); font-size: 23rpx; }.target-unit-switch { flex: 0 0 146rpx; display: flex; align-items: center; justify-content: center; gap: 4rpx; height: 72rpx; padding: 5rpx; border-radius: 12rpx; background: #F1F5FA; }.target-unit { flex: 1; min-width: 0; height: 62rpx; padding: 0; border-radius: 9rpx; display: flex; align-items: center; justify-content: center; color: var(--jt-muted); font-size: 22rpx; line-height: 1; }.target-unit.active { color: var(--jt-primary); background: #fff; box-shadow: 0 2rpx 8rpx rgba(24, 51, 92, .08); font-weight: 600; }.target-helper { display: block; margin-top: 10rpx; color: #8A9AB0; font-size: 20rpx; line-height: 1.5; }.target-error { display: block; margin-top: 10rpx; color: var(--jt-danger); font-size: 21rpx; }.upload-tip text { display: block; line-height: 1.65; }
.compress-progress { display: block; width: 100%; margin: 24rpx 0 12rpx; }.progress-tip { display: block; color: var(--jt-muted); font-size: 22rpx; }.result-card .primary-btn, .result-card .secondary-btn { height: 82rpx; }
.summary-card { margin: 18rpx 0 22rpx; padding: 24rpx 22rpx 18rpx; border: 1rpx solid #E3ECFA; border-radius: 20rpx; background: linear-gradient(135deg, #F7FAFF 0%, #EEF5FF 100%); }.summary-main { display: flex; align-items: center; width: 100%; }.summary-stat { flex: 1; min-width: 0; }.summary-stat-right { text-align: right; }.summary-kicker { display: block; color: var(--jt-muted); font-size: 22rpx; line-height: 1.3; }.summary-number { display: block; margin-top: 8rpx; color: var(--jt-navy); font-size: 34rpx; font-weight: 700; letter-spacing: -.5rpx; line-height: 1.1; white-space: nowrap; }.summary-transfer { flex: 0 0 82rpx; display: flex; flex-direction: column; align-items: center; margin: 0 10rpx; color: #8BA0BB; font-size: 18rpx; line-height: 1.2; }.summary-arrow { width: 48rpx; height: 36rpx; margin-bottom: 4rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; background: #E3EEFF; }.summary-arrow image { width: 30rpx; height: 30rpx; display: block; }.saved-badge { display: flex; align-items: baseline; justify-content: center; gap: 6rpx; margin-top: 20rpx; padding-top: 14rpx; border-top: 1rpx solid rgba(141, 186, 245, .35); color: #4F8F6A; font-size: 21rpx; line-height: 1.2; }.saved-value { color: var(--jt-success); font-size: 25rpx; font-weight: 700; }.result-head { display: flex; align-items: center; justify-content: space-between; margin: 12rpx 0; color: var(--jt-muted); font-size: 23rpx; }.result-file { display: flex; align-items: center; min-height: 96rpx; padding: 14rpx 0; border-bottom: 1rpx solid #F0F3F8; }.result-thumb { width: 72rpx; height: 72rpx; border-radius: 12rpx; object-fit: cover; }.result-file-info { flex: 1; min-width: 0; margin: 0 12rpx; }.result-file .file-size { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.preview-remove image { width: 38rpx; height: 38rpx; display: block; }
.result-target, .result-note { display: block; margin-top: 6rpx; font-size: 19rpx; line-height: 1.5; overflow-wrap: anywhere; }
.result-target { color: #27805B; }
.result-note { color: #8191A6; }
.result-file .file-size { white-space: normal; line-height: 1.5; }
.preview-failed { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #91A4BE; font-size: 20rpx; gap: 6rpx; }.preview-failed image { width: 72rpx; height: 72rpx; display: block; }
.selection-head { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; margin-bottom: 20rpx; text-align: left; }.selection-head > view { flex: 1; min-width: 0; text-align: left; }.selection-head > button { flex: 0 0 auto; white-space: nowrap; }.selection-title { display: block; font-size: 27rpx; font-weight: 700; }.selection-tip { display: block; color: var(--jt-muted); font-size: 21rpx; margin-top: 6rpx; }.preview-grid { display: grid; grid-template-columns: repeat(3, 1fr); grid-gap: 14rpx; margin-bottom: 22rpx; }.preview-tile { position: relative; width: 100%; min-width: 0; height: 190rpx; border-radius: 16rpx; overflow: hidden; background: #EEF5FF; }.preview-thumb { width: 100%; height: 100%; display: block; }.preview-index { position: absolute; left: 10rpx; top: 10rpx; min-width: 34rpx; height: 34rpx; padding: 0 8rpx; border-radius: 17rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: rgba(21, 35, 59, .72); font-size: 20rpx; }.preview-size { position: absolute; left: 0; right: 0; bottom: 0; padding: 28rpx 10rpx 10rpx; color: #fff; background: linear-gradient(180deg, rgba(21, 35, 59, 0) 0%, rgba(21, 35, 59, .78) 100%); font-size: 20rpx; font-weight: 600; line-height: 1; text-align: left; }.preview-remove { position: absolute; right: 8rpx; top: 8rpx; width: 38rpx; height: 38rpx; border-radius: 19rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: rgba(21, 35, 59, .72); font-size: 25rpx; line-height: 1; }
