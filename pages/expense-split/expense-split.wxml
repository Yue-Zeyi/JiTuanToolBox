<view class="page tool-page split-page">
  <view class="page-head"><view class="tool-title"><text class="title">AA 分账</text><text class="desc">多人垫付，自动算清谁补给谁</text></view><view class="tool-icon green"><image src="/assets/icons/expense-split.svg" mode="aspectFit"/></view></view>
  <view class="card split-panel"><view class="split-label-row"><text class="split-label">参与人</text><text class="split-hint">每行一个名字</text></view><textarea class="split-people" value="{{peopleText}}" bindinput="onPeopleInput" placeholder="例如：小明\n小红\n小刚" placeholder-class="split-placeholder" maxlength="1000"/><view class="split-label-row split-expense-title"><text class="split-label">支出记录</text><text class="split-hint">项目｜金额｜付款人｜参与人</text></view><textarea class="split-expenses" value="{{expenseText}}" bindinput="onExpenseInput" placeholder="晚餐｜240｜小明｜小明,小红,小刚\n打车｜60｜小红｜小明,小红" placeholder-class="split-placeholder" maxlength="5000"/><text class="split-example">每行一笔，参与人可用逗号分隔；金额按参与人数均分。</text><text wx:if="{{error}}" class="split-error">{{error}}</text></view>
  <button class="primary-btn split-main" bindtap="calculate">开始分账</button>
  <view class="card split-result"><view class="split-result-head"><text>分账结果</text><button bindtap="copyResult" disabled="{{!hasResult}}"><image src="/assets/icons/password-copy.svg" mode="aspectFit"/><text>复制</text></button></view><view wx:if="{{hasResult}}"><view class="split-total"><text>总支出</text><text>¥ {{totalText}}</text></view><view class="split-balances"><view wx:for="{{balances}}" wx:key="name" class="split-balance"><text>{{item.name}}</text><text class="{{item.amount > 0 ? 'positive' : item.amount < 0 ? 'negative' : 'even'}}">{{item.label}}</text></view></view><view class="split-settlements"><text class="split-section-title">建议转账</text><view wx:for="{{settlements}}" wx:key="index" class="split-settlement"><text>{{item.from}} → {{item.to}}</text><text>¥ {{item.amountText}}</text></view><text wx:if="{{!settlements.length}}" class="split-even-note">大家已均摊，无需转账</text></view></view><view wx:else class="split-empty">填写参与人与支出记录后生成清单</view></view>
  <button class="secondary-btn split-clear" bindtap="clearAll">清空输入</button>
  <view class="page-foot-tip"><view class="privacy-line"><image class="privacy-icon" src="/assets/icons/success.svg" mode="aspectFit"/><text class="privacy-copy">本地计算，参与人和金额不上传服务器</text></view></view>
</view>
