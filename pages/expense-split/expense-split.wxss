.split-page{padding-bottom:120rpx}.split-panel{padding:24rpx}.split-label-row{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.split-label{color:var(--jt-navy);font-size:27rpx;font-weight:700}.split-hint{color:#8A9AB0;font-size:19rpx}.split-people,.split-expenses{box-sizing:border-box;width:100%;margin-top:12rpx;padding:15rpx 16rpx;border:1rpx solid #DCE6F1;border-radius:13rpx;color:var(--jt-navy);background:#fff;font-size:24rpx;line-height:1.55}.split-people{height:150rpx}.split-expenses{height:230rpx}.split-expense-title{margin-top:24rpx}.split-placeholder{color:#A5B2C2}.split-example{display:block;margin-top:10rpx;color:#98A5B5;font-size:19rpx;line-height:1.5}.split-error{display:block;margin-top:12rpx;color:#C84F4F;font-size:21rpx}.split-main{width:100%;height:82rpx;margin-top:18rpx}.split-result{margin-top:18rpx;padding:24rpx}.split-result-head{display:flex;align-items:center;justify-content:space-between;color:var(--jt-navy);font-size:28rpx;font-weight:700}.split-result-head button{display:flex;align-items:center;gap:7rpx;color:var(--jt-primary);font-size:21rpx;font-weight:400}.split-result-head button[disabled]{opacity:.4}.split-result-head image{width:25rpx;height:25rpx}.split-total{display:flex;align-items:center;justify-content:space-between;margin-top:18rpx;padding:16rpx;border-radius:12rpx;color:#4F6681;background:#F7FAFD;font-size:22rpx}.split-total text:last-child{color:var(--jt-navy);font-size:30rpx;font-weight:700}.split-balances{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10rpx;margin-top:14rpx}.split-balance{display:flex;align-items:center;justify-content:space-between;gap:8rpx;padding:12rpx;border-bottom:1rpx solid #F0F3F8;color:#617895;font-size:21rpx}.split-balance text:last-child{font-weight:600}.positive{color:#2E9C6B}.negative{color:#D35D55}.even{color:#94A3B8}.split-settlements{margin-top:22rpx}.split-section-title{display:block;margin-bottom:10rpx;color:var(--jt-navy);font-size:23rpx;font-weight:700}.split-settlement{display:flex;align-items:center;justify-content:space-between;padding:14rpx 0;border-bottom:1rpx solid #F0F3F8;color:#52657E;font-size:22rpx}.split-settlement text:last-child{color:#2F80ED;font-weight:700}.split-even-note{display:block;padding:16rpx 0;color:#2E9C6B;font-size:21rpx}.split-empty{min-height:150rpx;display:flex;align-items:center;justify-content:center;color:#9AA8BB;font-size:22rpx}.split-clear{width:100%;height:70rpx;margin-top:16rpx}
