.color-page { padding-bottom: 100rpx; }
.color-page .page-head .tool-title { min-width: 0; }
.color-page .page-head .tool-icon { flex: 0 0 auto; }
.color-modes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8rpx; margin: 18rpx 0; padding: 6rpx; border: 1rpx solid #E1E9F3; border-radius: 12rpx; background: #EDF2F8; }
.color-modes button { display: flex; align-items: center; justify-content: center; min-width: 0; height: 64rpx; border-radius: 9rpx; color: #6C7E94; font-size: 23rpx; line-height: 1; }
.color-modes button.active { color: var(--jt-primary); background: #FFFFFF; box-shadow: 0 4rpx 12rpx rgba(30,76,130,.08); font-weight: 600; }
.color-input-panel, .color-result, .color-table { box-sizing: border-box; width: 100%; padding: 24rpx; overflow: hidden; }
.color-head { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; min-width: 0; color: var(--jt-navy); font-size: 26rpx; font-weight: 600; }
.color-head text:first-child { min-width: 0; }
.color-head text:last-child { flex: 0 0 auto; color: #8797AA; font-size: 19rpx; font-weight: 400; white-space: nowrap; }
.color-hex-input { display: flex; align-items: center; gap: 14rpx; height: 82rpx; margin-top: 18rpx; padding: 0 16rpx; border: 1px solid #D8E3EF; border-radius: 12rpx; background: #FFFFFF; }
.color-hex-input view { flex: 0 0 44rpx; width: 44rpx; height: 44rpx; border: 1rpx solid rgba(0,0,0,.1); border-radius: 10rpx; }
.color-hex-input input { flex: 1; width: 0; min-width: 0; height: 80rpx; color: #263B56; font-family: Consolas, Menlo, monospace; font-size: 28rpx; }
.color-fields { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; margin-top: 18rpx; }
.color-fields > view { box-sizing: border-box; display: flex; align-items: center; gap: 8rpx; min-width: 0; width: 100%; height: 82rpx; padding: 0 13rpx; border: 1px solid #D8E3EF; border-radius: 12rpx; background: #FFFFFF; }
.color-fields text { color: #8797AA; font-size: 21rpx; }
.color-fields input { flex: 1; width: 0; min-width: 0; height: 80rpx; color: #263B56; font-size: 26rpx; text-align: right; }
.color-main { width: 100%; height: 86rpx; margin-top: 18rpx; border-radius: 14rpx; }
.color-error { display: block; margin-top: 14rpx; color: #C84444; font-size: 22rpx; }
.color-result { margin-top: 18rpx; }
.color-result-swatch { box-sizing: border-box; display: flex; align-items: flex-end; width: 100%; max-width: 100%; height: 190rpx; padding: 18rpx; border-radius: 14rpx; box-shadow: inset 0 0 0 1rpx rgba(0,0,0,.08); }
.color-result-swatch text { padding: 7rpx 12rpx; border-radius: 8rpx; color: #FFFFFF; background: rgba(0,0,0,.38); font-family: Consolas, Menlo, monospace; font-size: 22rpx; }
.color-values { margin-top: 14rpx; }
.color-values button { box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; width: 100%; min-width: 0; min-height: 64rpx; border-bottom: 1rpx solid #EDF1F6; color: #3C526C; font-family: Consolas, Menlo, monospace; font-size: 21rpx; }
.color-values button text:first-child { color: #8A9AB0; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 19rpx; }
.color-values button text:last-child { min-width: 0; max-width: 80%; font-size: 19rpx; text-align: right; overflow-wrap: anywhere; }
.color-save { width: 100%; height: 72rpx; margin-top: 16rpx; border-radius: 12rpx; font-size: 22rpx; }
.color-table { margin-top: 18rpx; }
.color-search { display: flex; align-items: center; gap: 10rpx; height: 72rpx; margin-top: 16rpx; padding: 0 15rpx; border: 1rpx solid #DDE6F0; border-radius: 11rpx; background: #F8FAFD; }
.color-search image { width: 28rpx; height: 28rpx; }
.color-search input { flex: 1; width: 0; min-width: 0; height: 70rpx; color: #334A64; font-size: 22rpx; }
.color-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; margin-top: 18rpx; }
.color-grid button { box-sizing: border-box; min-width: 0; width: 100%; padding: 10rpx; border: 1rpx solid #E1E8F1; border-radius: 11rpx; background: #FFFFFF; text-align: left; }
.color-grid view { width: 100%; height: 62rpx; border: 1rpx solid rgba(0,0,0,.07); border-radius: 8rpx; }
.color-grid text { display: block; overflow: hidden; margin-top: 8rpx; color: #425972; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.color-grid text + text { margin-top: 3rpx; color: #8B9AAD; font-family: Consolas, Menlo, monospace; font-size: 17rpx; }
.color-empty { display: block; padding: 60rpx 0 36rpx; color: #91A0B2; font-size: 21rpx; line-height: 1.5; text-align: center; }
@media (max-width: 350px) {
  .color-head { align-items: flex-start; }
  .color-head text:last-child { max-width: 62%; padding-top: 4rpx; font-size: 17rpx; text-align: right; white-space: normal; }
  .color-fields { gap: 8rpx; }
  .color-fields > view { padding: 0 9rpx; }
  .color-fields input { font-size: 23rpx; }
  .color-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
