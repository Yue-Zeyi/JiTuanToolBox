<view class="page tool-page color-page">
  <view class="page-head"><view class="tool-title"><text class="title">颜色查询表</text><text class="desc">颜色数值互查与常用色表</text></view><view class="tool-icon orange"><image src="/assets/icons/color-query.svg" mode="aspectFit"/></view></view>
  <view class="color-modes"><button class="{{mode === 'hex' ? 'active' : ''}}" data-mode="hex" bindtap="selectMode">HEX</button><button class="{{mode === 'rgb' ? 'active' : ''}}" data-mode="rgb" bindtap="selectMode">RGB</button><button class="{{mode === 'hsl' ? 'active' : ''}}" data-mode="hsl" bindtap="selectMode">HSL</button></view>
  <view class="card color-input-panel">
    <view class="color-head"><text>输入颜色</text><text>{{mode === 'hex' ? '支持 #RGB 与 #RRGGBB' : (mode === 'rgb' ? '每项 0–255' : 'H 0–360，S/L 0–100')}}</text></view>
    <view wx:if="{{mode === 'hex'}}" class="color-hex-input"><view style="background:{{result.hex}}"></view><input value="{{hexInput}}" bindinput="onHex" maxlength="7" placeholder="#2F80ED"/></view>
    <view wx:elif="{{mode === 'rgb'}}" class="color-fields"><view><text>R</text><input type="number" value="{{red}}" data-key="red" bindinput="onChannel" maxlength="3"/></view><view><text>G</text><input type="number" value="{{green}}" data-key="green" bindinput="onChannel" maxlength="3"/></view><view><text>B</text><input type="number" value="{{blue}}" data-key="blue" bindinput="onChannel" maxlength="3"/></view></view>
    <view wx:else class="color-fields"><view><text>H</text><input type="number" value="{{hue}}" data-key="hue" bindinput="onChannel" maxlength="3"/></view><view><text>S</text><input type="number" value="{{saturation}}" data-key="saturation" bindinput="onChannel" maxlength="3"/></view><view><text>L</text><input type="number" value="{{lightness}}" data-key="lightness" bindinput="onChannel" maxlength="3"/></view></view>
  </view>
  <button class="primary-btn color-main" bindtap="convert">查询颜色</button><text wx:if="{{error}}" class="color-error">{{error}}</text>
  <view class="card color-result"><view class="color-result-swatch" style="background:{{result.hex}}"><text>{{result.hex}}</text></view><view class="color-values"><button data-key="hex" bindtap="copyValue"><text>HEX</text><text>{{result.hex}}</text></button><button data-key="rgb" bindtap="copyValue"><text>RGB</text><text>{{result.rgb}}</text></button><button data-key="hsl" bindtap="copyValue"><text>HSL</text><text>{{result.hsl}}</text></button><button data-key="cmyk" bindtap="copyValue"><text>CMYK</text><text>{{result.cmyk}}</text></button></view><button class="secondary-btn color-save" bindtap="saveRecord" loading="{{saving}}">{{saved ? '已保存记录' : '保存颜色记录'}}</button></view>
  <view class="card color-table"><view class="color-head"><text>常用颜色表</text><text>{{colors.length}} 种颜色</text></view><view class="color-search"><image src="/assets/icons/search.svg" mode="aspectFit"/><input value="{{query}}" bindinput="queryColor" placeholder="搜索中文名、英文名或色值" maxlength="30"/></view><view class="color-grid"><button wx:for="{{colors}}" wx:key="id" data-id="{{item.id}}" bindtap="choosePreset"><view style="background:{{item.hex}}"></view><text>{{item.name}}</text><text>{{item.hex}}</text></button></view><text wx:if="{{!colors.length}}" class="color-empty">没有找到对应的常用颜色</text></view>
  <view class="page-foot-tip"><view class="privacy-line"><image class="privacy-icon" src="/assets/icons/success.svg" mode="aspectFit"/><text class="privacy-copy">本地查询，颜色数据不上传服务器</text></view></view>
</view>
