.unit-page { padding-bottom: 90rpx; }
.unit-category-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 22rpx 0; }
.unit-label { color: #718096; font-size: 23rpx; }
.unit-category-row picker { width: 260rpx; }
.unit-category { display: flex; align-items: center; justify-content: space-between; min-height: 70rpx; padding: 12rpx 18rpx; border: 1rpx solid #D9E5F2; border-radius: 12rpx; background: #FFFFFF; color: #1768C5; font-size: 26rpx; font-weight: 600; }
.unit-category image, .unit-picker image { flex: 0 0 24rpx; width: 24rpx; height: 24rpx; }
.unit-form { padding: 24rpx 0 22rpx; border-top: 1rpx solid #D9E5F2; border-bottom: 1rpx solid #D9E5F2; }
.unit-selectors { display: grid; grid-template-columns: minmax(0, 1fr) 62rpx minmax(0, 1fr); gap: 12rpx; align-items: center; }
.unit-selector { min-width: 0; }
.unit-picker { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; min-height: 130rpx; margin-top: 10rpx; padding: 14rpx 12rpx; border: 1rpx solid #D9E5F2; border-radius: 12rpx; background: #FFFFFF; }
.unit-picker > view { flex: 1; min-width: 0; }
.unit-picker-symbol { display: block; color: #234666; font-family: Consolas, Monaco, monospace; font-size: 27rpx; font-weight: 600; overflow-wrap: anywhere; }
.unit-picker-title { display: block; margin-top: 7rpx; color: #718096; font-size: 21rpx; line-height: 1.45; overflow-wrap: anywhere; }
.unit-swap { display: flex; align-items: center; justify-content: center; width: 62rpx; height: 80rpx; margin-top: 36rpx; border-radius: 12rpx; background: #EAF3FE; }
.unit-swap image { width: 34rpx; height: 34rpx; }
.unit-input-head, .unit-result-heading { display: flex; align-items: center; justify-content: space-between; min-height: 62rpx; }
.unit-input-head { margin-top: 20rpx; }
.unit-icon-button { display: flex; align-items: center; justify-content: center; width: 62rpx; height: 62rpx; flex: 0 0 62rpx; }
.unit-icon-button image { width: 30rpx; height: 30rpx; }
.unit-input { box-sizing: border-box; width: 100%; height: 86rpx; padding: 0 18rpx; border: 1rpx solid #CBDCED; border-radius: 12rpx; background: #FFFFFF; color: #234666; font-family: Consolas, Monaco, monospace; font-size: 30rpx; }
.unit-placeholder { color: #9AA8BB; }
.unit-error { display: block; margin-top: 12rpx; color: #C84444; font-size: 22rpx; line-height: 1.5; }
.unit-result { min-height: 190rpx; margin-top: 18rpx; }
.unit-result-value { display: flex; align-items: baseline; gap: 12rpx; color: #1768C5; font-family: Consolas, Monaco, monospace; font-size: 36rpx; line-height: 1.4; font-weight: 600; }
.unit-result-value > text:last-child { min-width: 0; overflow-wrap: anywhere; word-break: break-all; }
.unit-approximate { flex: 0 0 auto; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 23rpx; font-weight: 400; }
.unit-result-symbol { display: block; margin-top: 8rpx; color: #516D8B; font-family: Consolas, Monaco, monospace; font-size: 24rpx; }
.unit-precision { display: block; margin-top: 10rpx; color: #8794A7; font-size: 20rpx; }
.unit-all-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 90rpx; color: var(--jt-navy); font-size: 27rpx; font-weight: 700; }
.unit-copy-all { display: flex; align-items: center; gap: 7rpx; min-height: 66rpx; color: #1768C5; font-size: 23rpx; font-weight: 400; }
.unit-copy-all image { width: 25rpx; height: 25rpx; }
.unit-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 18rpx; align-items: center; min-height: 92rpx; padding: 14rpx 12rpx; border-bottom: 1rpx solid #E5ECF4; }
.unit-row.selected { background: #EAF3FE; }
.unit-row-name { min-width: 0; font-size: 22rpx; color: #516D8B; line-height: 1.5; }
.unit-row-name text { display: block; overflow-wrap: anywhere; }
.unit-row-name text:last-child { color: #8998AA; font-size: 20rpx; }
.unit-row-value { color: #234666; font-family: Consolas, Monaco, monospace; font-size: 23rpx; line-height: 1.5; text-align: right; overflow-wrap: anywhere; word-break: break-all; }
.unit-empty { display: flex; align-items: center; justify-content: center; min-height: 150rpx; color: #93A2B3; font-size: 24rpx; }
.unit-page button[disabled] { opacity: .4; }
