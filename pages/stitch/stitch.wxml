<view class="page tool-page stitch-page">
  <view class="page-head">
    <view class="tool-title"><text class="title">图片拼接</text><text class="desc">多图合成长图、横图，自定义排列</text></view>
    <view class="tool-icon orange"><image src="/assets/icons/stitch.svg" mode="aspectFit"/></view>
  </view>

  <view class="card upload-card stitch-upload" wx:if="{{state === 'empty' || state === 'processing'}}">
    <view class="stitch-selection-head" wx:if="{{files.length}}"><view><text class="stitch-selection-title">已选择 {{files.length}} 张图片</text><text class="stitch-selection-tip">按选择顺序进行拼接 · 点击缩略图查看</text></view><button class="ghost-btn stitch-add" bindtap="chooseImages" disabled="{{files.length >= maxFiles}}">继续添加</button></view>
    <view class="stitch-preview-grid" wx:if="{{files.length}}">
      <block wx:for="{{files}}" wx:key="path" wx:for-index="index">
        <view class="stitch-preview-tile" data-index="{{index}}" bindtap="previewImage"><image wx:if="{{!item.previewFailed}}" class="stitch-preview-thumb" src="{{item.path}}" mode="aspectFill" lazy-load="true" binderror="onPreviewError" data-index="{{index}}"/><view wx:else class="preview-failed"><image src="/assets/icons/image-broken.svg" mode="aspectFit"/><text>无法预览</text></view><view class="stitch-preview-index">{{index + 1}}</view><view class="stitch-preview-size">{{item.sizeText}}</view><button class="stitch-preview-remove" data-index="{{index}}" catchtap="removeFile"><image src="/assets/icons/remove.svg" mode="aspectFit"/></button></view>
      </block>
    </view>
    <view class="upload-dash stitch-upload-dash" bindtap="chooseImages"><image class="upload-plus" src="/assets/icons/add.svg" mode="aspectFit"/><text class="upload-title">{{files.length ? '继续选择图片' : '选择图片'}}</text><view class="upload-tip"><text>支持 JPG、JPEG、PNG、BMP、WEBP、JFIF、JPE</text><text>单张不超过 20MB · 最多 {{maxFiles}} 张</text><text wx:if="{{files.length}}">还可添加 {{maxFiles - files.length}} 张</text></view></view>
  </view>

  <view class="card panel stitch-panel" wx:if="{{state === 'empty' || state === 'processing'}}">
    <view class="panel-section stitch-layout-section">
      <view class="section-heading"><text class="panel-title">拼接方式</text><text class="section-caption">保持原图比例排版</text></view>
      <view class="stitch-layout-grid"><block wx:for="{{layoutOptions}}" wx:key="key"><button class="stitch-layout-option {{layout === item.key ? 'active' : ''}}" data-layout="{{item.key}}" bindtap="setLayout"><text class="stitch-layout-title">{{item.title}}</text><text class="stitch-layout-desc">{{item.desc}}</text></button></block></view>
      <text class="stitch-helper">{{layout === 'vertical' ? '图片会从上到下居中排列，适合聊天记录和长截图。' : (layout === 'horizontal' ? '图片会从左到右居中排列，适合横向对比和拼图。' : '图片会按行列整齐排列，适合多图展示。')}}</text>
    </view>

    <view wx:if="{{layout === 'grid'}}" class="panel-section stitch-grid-section">
      <view class="section-heading stitch-grid-heading"><text class="panel-label">每行图片数</text><view class="stitch-columns-editor"><button class="stitch-column-stepper" data-delta="-1" bindtap="setGridColumns" disabled="{{gridColumns <= 1}}" aria-label="减少列数"><image src="/assets/icons/minus.svg" mode="aspectFit"/></button><view class="stitch-columns-input-wrap"><input class="stitch-columns-input" type="number" maxlength="2" value="{{gridColumnsInput}}" bindinput="onGridColumnsInput" bindblur="onGridColumnsBlur"/><text>列</text></view><button class="stitch-column-stepper" data-delta="1" bindtap="setGridColumns" disabled="{{gridColumns >= gridColumnsMax}}" aria-label="增加列数"><image src="/assets/icons/plus-small.svg" mode="aspectFit"/></button></view></view>
      <text class="stitch-columns-helper">每行最多 {{gridColumnsMax}} 张，行数根据上传图片自动计算。</text>
    </view>

    <view class="panel-section stitch-style-section">
      <view class="section-heading"><text class="panel-label">间距</text><text class="section-caption">图片之间的留白大小</text></view>
      <view class="choice-row stitch-gap-row"><block wx:for="{{gapOptions}}" wx:key="key"><button class="choice {{gap === item.key ? 'active' : ''}}" data-gap="{{item.key}}" bindtap="setGap">{{item.title}}</button></block></view>
    </view>

    <view class="panel-section stitch-background-section">
      <view class="section-heading"><text class="panel-label">背景色</text><text class="section-caption">透明背景需选择 PNG</text></view>
      <view class="stitch-background-row"><block wx:for="{{backgroundOptions}}" wx:key="key"><button class="stitch-background-option {{background === item.key ? 'active' : ''}}" data-background="{{item.key}}" bindtap="setBackground"><view class="stitch-color-swatch {{item.key}}"></view><text>{{item.title}}</text></button></block></view>
    </view>

    <view class="panel-section stitch-output-section">
      <view class="section-heading"><text class="panel-label">输出格式</text><text class="section-caption">{{format === 'png' ? '保留透明背景' : '适合分享与上传'}}</text></view>
      <view class="choice-row stitch-format-row"><button class="choice {{format === 'auto' ? 'active' : ''}}" data-format="auto" bindtap="setFormat">自动</button><button class="choice {{format === 'jpg' ? 'active' : ''}}" data-format="jpg" bindtap="setFormat">JPG</button><button class="choice {{format === 'png' ? 'active' : ''}}" data-format="png" bindtap="setFormat">PNG</button></view>
      <view wx:if="{{format != 'png'}}" class="quality-row"><view class="quality-head"><text class="panel-label">JPG 质量</text><text class="slider-value">{{quality}}%</text></view><slider class="stitch-slider" min="20" max="100" value="{{quality}}" activeColor="#F2A04F" backgroundColor="#F3E4D1" block-size="22" bindchanging="onQuality"/><text class="stitch-quality-help">质量越高越清晰，文件体积也会相应增加</text></view>
    </view>
  </view>

  <button wx:if="{{state === 'empty' || state === 'processing'}}" class="primary-btn start-btn stitch-start" bindtap="startStitch" disabled="{{state === 'processing'}}">{{state === 'processing' ? '正在拼接…' : '开始拼接图片'}}</button>
  <canvas id="stitchCanvas" type="2d" class="stitch-canvas"></canvas>

  <view wx:if="{{state === 'processing'}}" class="card state-card"><image class="state-mark-icon loading" src="/assets/icons/loading.svg" mode="aspectFit"/><text class="state-title">正在拼接图片</text><text class="state-desc">{{currentStep}} · 已完成 {{progress}}%</text><progress class="compress-progress" percent="{{progress}}" activeColor="#F2A04F" backgroundColor="#F8EAD8" stroke-width="6"/><text class="progress-tip">正在本地生成拼接结果，请不要关闭页面</text></view>

  <view wx:if="{{state === 'success'}}" class="card result-card stitch-result">
    <view class="stitch-result-heading"><view><view class="eyebrow">处理完成</view><text class="stitch-result-title">图片拼接完成</text></view><view class="stitch-result-count"><text>{{result.fileCount}}</text><text>张</text></view></view>
    <view class="stitch-result-preview" bindtap="previewResult"><image src="{{result.outputPath}}" mode="aspectFit"/><view class="stitch-result-preview-tip">点击查看大图</view></view>
    <view class="stitch-result-summary"><view class="stitch-summary-main"><text class="stitch-summary-number">{{result.width}} × {{result.height}}</text><text class="stitch-summary-label">px</text></view><view class="stitch-summary-meta"><text>{{result.layoutLabel}} · {{result.gapLabel}}</text><text>{{result.formatLabel}} · {{result.sizeText}}</text></view></view>
    <view class="stitch-result-actions"><button class="primary-btn stitch-save" bindtap="saveResult">保存图片</button><view class="stitch-secondary-actions"><button class="secondary-btn" bindtap="chooseAgain">再次拼接</button><button class="secondary-btn" bindtap="goHome">返回首页</button></view></view>
  </view>

  <view wx:if="{{state === 'error'}}" class="card state-card"><image class="state-mark-icon error" src="/assets/icons/error.svg" mode="aspectFit"/><text class="state-title">拼接失败</text><text class="state-desc">{{error}}</text><view class="action-row"><button class="secondary-btn" bindtap="chooseAgain">重新选择</button><button class="primary-btn" bindtap="retry">再次尝试</button></view></view>
  <view class="page-foot-tip"><view class="privacy-line"><image class="privacy-icon" src="/assets/icons/success.svg" mode="aspectFit"/><text class="privacy-copy">本地处理，图片临时上传微信安检</text></view><text class="privacy-detail">检测后删除云端临时文件</text></view>
  <canvas id="securityCanvas" type="2d" class="security-canvas"></canvas>
</view>
