.picker-page { padding-bottom: 110rpx; }
.picker-workspace, .picker-result { padding: 24rpx; }
.picker-workspace { margin-top: 0; }
.picker-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; min-height: 300rpx; border: 2rpx dashed #B8D1F3; border-radius: 16rpx; background: #F8FBFF; color: var(--jt-navy); font-size: 27rpx; font-weight: 600; }
.picker-empty image { width: 72rpx; height: 72rpx; margin-bottom: 14rpx; }
.picker-empty text + text { margin-top: 8rpx; color: #8A9AB0; font-size: 20rpx; font-weight: 400; }
.picker-canvas-wrap { position: relative; width: 100%; height: 470rpx; overflow: hidden; border-radius: 14rpx; background-color: #EEF2F6; background-image: linear-gradient(45deg,#E1E7EE 25%,transparent 25%),linear-gradient(-45deg,#E1E7EE 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#E1E7EE 75%),linear-gradient(-45deg,transparent 75%,#E1E7EE 75%); background-size: 24rpx 24rpx; background-position: 0 0,0 12rpx,12rpx -12rpx,-12rpx 0; }
.picker-canvas { display: block; width: 100%; height: 470rpx; }
.picker-crosshair { position: absolute; width: 34rpx; height: 34rpx; margin: -17rpx 0 0 -17rpx; border: 4rpx solid #FFFFFF; border-radius: 50%; box-shadow: 0 0 0 2rpx #25364B, 0 4rpx 12rpx rgba(0,0,0,.2); pointer-events: none; }
.picker-crosshair view { position: absolute; left: 13rpx; top: 13rpx; width: 4rpx; height: 4rpx; border-radius: 50%; background: #FFFFFF; }
.picker-loading { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #64768D; background: rgba(247,249,252,.88); font-size: 23rpx; }
.picker-file { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 14rpx; }
.picker-file > view { flex: 1; min-width: 0; }
.picker-file text { display: block; overflow: hidden; color: var(--jt-navy); font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.picker-file text + text { margin-top: 5rpx; color: #8898AA; font-size: 19rpx; }
.picker-file button { flex: 0 0 auto; font-size: 22rpx; }
.picker-result { margin-top: 18rpx; }
.picker-head { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; color: var(--jt-navy); font-size: 26rpx; font-weight: 600; }
.picker-head text:last-child { color: #8A9AB0; font-size: 19rpx; font-weight: 400; }
.picker-color { display: flex; align-items: stretch; gap: 16rpx; margin-top: 18rpx; }
.picker-swatch { flex: 0 0 150rpx; width: 150rpx; min-height: 190rpx; border: 1rpx solid rgba(20,35,58,.1); border-radius: 13rpx; }
.picker-values { flex: 1; min-width: 0; }
.picker-values button { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; width: 100%; min-height: 58rpx; padding: 0 12rpx; border-bottom: 1rpx solid #EDF1F6; color: #53677E; font-size: 21rpx; }
.picker-values button:last-child { border-bottom: 0; }
.picker-values button text:first-child { color: #8A9AB0; font-size: 18rpx; }
.picker-values button text:last-child { min-width: 0; color: #41566F; font-size: 18rpx; text-align: right; overflow-wrap: anywhere; }
.picker-no-color { display: flex; align-items: center; justify-content: center; height: 150rpx; margin-top: 16rpx; border-radius: 12rpx; color: #91A0B2; background: #F7F9FC; font-size: 21rpx; }
.picker-recent { margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #EDF1F6; }
.picker-recent > text { color: #75879C; font-size: 21rpx; }
.picker-recent > view { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.picker-recent button { width: 54rpx; height: 54rpx; border: 4rpx solid #FFFFFF; border-radius: 11rpx; box-shadow: 0 0 0 1rpx #D9E2ED; }
.picker-actions { display: grid; grid-template-columns: 1fr 1.25fr; gap: 12rpx; margin-top: 18rpx; }
.picker-actions button { width: 100%; height: 78rpx; border-radius: 13rpx; font-size: 23rpx; }
.picker-page .page-foot-tip { margin-top: 24rpx; }
.picker-page .privacy-line { align-items: center; }
.picker-page .privacy-copy, .picker-page .privacy-detail { text-align: center; }
