.text-clean-page { padding-bottom: 150rpx; }
.clean-editor-card { margin-top: 2rpx; padding: 24rpx; overflow: hidden; }
.clean-editor-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.clean-editor-head > view:first-child { min-width: 0; }
.clean-editor-title { display: block; color: var(--jt-navy); font-size: 28rpx; font-weight: 700; line-height: 1.35; }
.clean-editor-subtitle { display: block; margin-top: 5rpx; color: #8A9AB0; font-size: 20rpx; line-height: 1.4; }
.clean-editor-counter { flex: 0 0 auto; padding: 7rpx 11rpx; border-radius: 10rpx; color: #31916B; background: #EAF9F1; font-size: 20rpx; font-weight: 600; line-height: 1.2; white-space: nowrap; }
.clean-textarea { box-sizing: border-box; display: block; width: 100%; max-width: 100%; height: 300rpx; margin-top: 18rpx; padding: 16rpx 18rpx; border: 1rpx solid #DCE8F7; border-radius: 17rpx; color: var(--jt-navy); background: #FFFFFF; font-size: 25rpx; line-height: 1.55; }
.clean-placeholder { color: #A5B2C2; }
.clean-editor-foot { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; margin-top: 12rpx; color: #97A6B8; font-size: 19rpx; line-height: 1.4; }
.clean-editor-foot text:first-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.clean-editor-foot text:last-child { flex: 0 0 auto; color: #4F8F6A; }
.clean-replace-card { margin-top: 18rpx; padding: 24rpx; }
.clean-replace-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 14rpx; }
.clean-replace-head > view { min-width: 0; }
.clean-replace-title { display: block; color: var(--jt-navy); font-size: 28rpx; font-weight: 700; line-height: 1.35; }
.clean-replace-subtitle { display: block; margin-top: 5rpx; color: #8A9AB0; font-size: 20rpx; line-height: 1.4; }
.clean-replace-badge { flex: 0 0 auto; padding: 6rpx 10rpx; border-radius: 9rpx; color: #6E8DB7; background: #EEF5FF; font-size: 19rpx; line-height: 1.2; }
.clean-replace-fields { display: flex; gap: 10rpx; margin-top: 18rpx; }
.clean-replace-input { box-sizing: border-box; flex: 1; min-width: 0; height: 70rpx; padding: 0 14rpx; border: 1rpx solid var(--jt-border); border-radius: 12rpx; color: var(--jt-navy); background: #FBFCFE; font-size: 23rpx; }
.clean-replace-tools { display: flex; align-items: center; gap: 12rpx; margin-top: 14rpx; }
.clean-regex-toggle { flex: 0 0 auto; display: flex; align-items: center; gap: 8rpx; color: #6E7F96; font-size: 21rpx; }
.clean-regex-toggle.active { color: #2E8D66; }
.clean-regex-check { width: 28rpx; height: 28rpx; border: 1rpx solid #CAD7E7; border-radius: 8rpx; background: #fff; display: flex; align-items: center; justify-content: center; }
.clean-regex-toggle.active .clean-regex-check { border: 0; background: transparent; }
.clean-regex-check image { width: 28rpx; height: 28rpx; display: block; }
.clean-regex-help { flex: 1; min-width: 0; overflow: hidden; color: #A0AEC0; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.clean-replace-btn { width: 100%; height: 72rpx; margin-top: 16rpx; }
.clean-replace-error { display: block; margin-top: 8rpx; color: #D65A5A; font-size: 19rpx; line-height: 1.4; }
.clean-options-card { margin-top: 18rpx; padding: 24rpx; }
.clean-options-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.clean-options-head > view { min-width: 0; }
.clean-options-title { display: block; color: var(--jt-navy); font-size: 28rpx; font-weight: 700; line-height: 1.35; }
.clean-options-subtitle { display: block; margin-top: 5rpx; color: #8A9AB0; font-size: 20rpx; line-height: 1.4; }
.clean-reset-btn { flex: 0 0 auto; padding: 8rpx 0 8rpx 12rpx; color: var(--jt-primary); font-size: 22rpx; white-space: nowrap; }
.clean-option-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10rpx; width: 100%; margin-top: 20rpx; }
.clean-option { box-sizing: border-box; width: 100%; min-width: 0; min-height: 92rpx; padding: 14rpx 12rpx; border: 1px solid var(--jt-border); border-radius: 15rpx; background: #FBFCFE; display: flex; align-items: center; gap: 10rpx; text-align: left; }
.clean-option.active { border-color: #9BD5BB; background: #F0FBF5; }
.clean-option-check { flex: 0 0 30rpx; width: 30rpx; height: 30rpx; border: 1rpx solid #CAD7E7; border-radius: 9rpx; background: #fff; display: flex; align-items: center; justify-content: center; }
.clean-option.active .clean-option-check { border: 0; background: transparent; }
.clean-option-check image { width: 30rpx; height: 30rpx; display: block; }
.clean-option-copy { min-width: 0; flex: 1; }
.clean-option-title { display: block; overflow: hidden; color: var(--jt-navy); font-size: 23rpx; font-weight: 600; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.clean-option-desc { display: block; overflow: hidden; margin-top: 5rpx; color: #8A9AB0; font-size: 18rpx; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }
.clean-option.active .clean-option-title { color: #2E8D66; }
.clean-option.active .clean-option-desc { color: #65A786; }
.clean-result-card { margin-top: 18rpx; padding: 24rpx; }
.clean-result-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 14rpx; }
.clean-result-title { display: block; color: var(--jt-navy); font-size: 28rpx; font-weight: 700; line-height: 1.35; }
.clean-result-subtitle { display: block; margin-top: 5rpx; color: #8A9AB0; font-size: 20rpx; line-height: 1.4; }
.clean-result-meta { flex: 0 0 auto; display: flex; flex-direction: column; align-items: flex-end; gap: 5rpx; color: #4F8F6A; font-size: 19rpx; line-height: 1.3; white-space: nowrap; }
.clean-result-meta text:last-child { color: #8A9AB0; }
.clean-result-box { box-sizing: border-box; width: 100%; height: 300rpx; margin-top: 18rpx; padding: 18rpx; border: 1rpx solid #DCE8F7; border-radius: 17rpx; background: #FFFFFF; }
.clean-result-text { display: block; color: var(--jt-navy); font-size: 25rpx; line-height: 1.65; white-space: pre-wrap; word-break: break-all; }
.clean-result-empty { height: 210rpx; margin-top: 18rpx; border: 1rpx dashed #C9D9EC; border-radius: 17rpx; background: #FBFDFF; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #9AA8BB; font-size: 21rpx; }
.clean-result-empty image { width: 58rpx; height: 58rpx; margin-bottom: 12rpx; opacity: .68; }
.clean-result-actions { display: flex; gap: 12rpx; margin-top: 18rpx; }
.clean-result-actions > button { flex: 1; height: 78rpx; }
.clean-bottom-actions { display: flex; gap: 12rpx; margin-top: 18rpx; }
.clean-bottom-actions > button { flex: 1; height: 82rpx; }
