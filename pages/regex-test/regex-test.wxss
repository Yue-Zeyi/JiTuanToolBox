.regex-page { padding-bottom: 100rpx; }
.regex-page .page-head .tool-title { min-width: 0; }
.regex-page .page-head .tool-icon { flex: 0 0 auto; }
.regex-pattern, .regex-flags, .regex-text, .regex-results { box-sizing: border-box; width: 100%; padding: 24rpx; overflow: hidden; }
.regex-pattern { margin-top: 18rpx; }
.regex-head { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; min-width: 0; color: var(--jt-navy); font-size: 26rpx; font-weight: 600; }
.regex-head text:first-child { min-width: 0; }
.regex-head text:last-child { flex: 0 0 auto; color: #8797AA; font-size: 20rpx; font-weight: 400; white-space: nowrap; }
.regex-pattern-input { box-sizing: border-box; display: flex; align-items: flex-start; width: 100%; max-width: 100%; gap: 8rpx; margin-top: 16rpx; padding: 17rpx; border: 1px solid #D8E3EF; border-radius: 12rpx; background: #FFFFFF; color: #8C9AAD; font-family: Consolas, Menlo, monospace; font-size: 24rpx; line-height: 1.55; overflow: hidden; }
.regex-pattern-input textarea { flex: 1; width: 0; min-width: 0; min-height: 48rpx; max-height: 180rpx; color: #263B56; font-family: Consolas, Menlo, monospace; font-size: 23rpx; line-height: 1.55; }
.regex-pattern-input > text:last-child { flex: 0 0 auto; max-width: 105rpx; overflow: hidden; white-space: nowrap; }
.regex-flags, .regex-text, .regex-results { margin-top: 18rpx; }
.regex-flag-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10rpx; margin-top: 16rpx; }
.regex-flag-grid button { display: flex; flex-direction: column; justify-content: center; box-sizing: border-box; min-width: 0; width: 100%; height: 88rpx; padding: 11rpx 13rpx; border: 1px solid #D8E3EF; border-radius: 11rpx; background: #FBFCFE; text-align: left; }
.regex-flag-grid text { display: block; color: #53677E; font-size: 21rpx; }
.regex-flag-grid text + text { margin-top: 4rpx; overflow: hidden; color: #8A9AB0; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.regex-flag-grid button.active { border-color: #83B4EF; background: #EEF6FF; box-shadow: inset 0 0 0 1rpx #D5E7FB; }
.regex-flag-grid button.active text:first-child { color: var(--jt-primary); font-weight: 600; }
.regex-text > textarea { box-sizing: border-box; display: block; width: 100%; max-width: 100%; height: 320rpx; margin-top: 16rpx; padding: 18rpx; border: 1px solid #D8E3EF; border-radius: 12rpx; background: #FFFFFF; color: #263B56; font-size: 23rpx; line-height: 1.65; overflow: hidden; }
.regex-main { width: 100%; height: 86rpx; margin-top: 18rpx; border-radius: 14rpx; }
.regex-error { display: block; margin-top: 14rpx; padding: 14rpx 18rpx; border-radius: 12rpx; color: #B84141; background: #FFF5F5; font-size: 22rpx; line-height: 1.5; }
.regex-result-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.regex-result-head view { min-width: 0; }
.regex-result-head view text { color: var(--jt-navy); font-size: 26rpx; font-weight: 600; }
.regex-result-head view text + text { margin-left: 10rpx; color: #2F80ED; font-size: 20rpx; }
.regex-result-head button { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; min-height: 54rpx; color: var(--jt-primary); font-size: 21rpx; line-height: 1; }
.regex-highlight { box-sizing: border-box; display: block; width: 100%; max-width: 100%; height: 260rpx; margin-top: 14rpx; padding: 16rpx; border: 1rpx solid #E1E8F1; border-radius: 12rpx; background: #F8FAFD; color: #53677E; font-family: Consolas, Menlo, monospace; font-size: 23rpx; line-height: 1.7; overflow-wrap: anywhere; word-break: break-all; }
.regex-segment.match { color: #1768C5; background: #DCEBFF; }
.regex-empty { display: block; color: #8A9AB0; text-align: center; line-height: 220rpx; }
.regex-warning { display: block; margin-top: 10rpx; color: #A56A1E; font-size: 20rpx; }
.regex-match-list { margin-top: 16rpx; }
.regex-match { padding: 14rpx 0; border-top: 1rpx solid #EDF1F6; }
.regex-match-head { display: flex; justify-content: space-between; color: #8A9AB0; font-size: 19rpx; }
.regex-match-value { display: block; margin-top: 8rpx; color: #263B56; font-family: Consolas, Menlo, monospace; font-size: 22rpx; overflow-wrap: anywhere; }
.regex-groups { margin-top: 8rpx; padding: 10rpx 12rpx; border-radius: 9rpx; background: #F3F6FA; }
.regex-groups text { display: block; color: #657990; font-size: 19rpx; line-height: 1.6; overflow-wrap: anywhere; }
.regex-bottom { display: grid; grid-template-columns: 1fr 1.25fr; gap: 12rpx; margin-top: 18rpx; }
.regex-bottom button { min-width: 0; width: 100%; height: 78rpx; border-radius: 13rpx; font-size: 23rpx; }
.regex-note { display: block; margin: 14rpx 8rpx 0; color: #8A9AB0; font-size: 20rpx; line-height: 1.55; text-align: center; overflow-wrap: anywhere; }
@media (max-width: 350px) {
  .regex-head { align-items: flex-start; }
  .regex-head text:last-child { padding-top: 4rpx; font-size: 18rpx; }
  .regex-flag-grid { grid-template-columns: 1fr; }
  .regex-flag-grid button { height: 82rpx; }
  .regex-result-head { align-items: flex-start; }
  .regex-bottom button { font-size: 21rpx; }
}
