<view class="page tool-page regex-page">
  <view class="page-head"><view class="tool-title"><text class="title">正则表达式测试</text><text class="desc">验证表达式并查看匹配与捕获组</text></view><view class="tool-icon orange"><image src="/assets/icons/regex-test.svg" mode="aspectFit"/></view></view>
  <view class="card regex-pattern"><view class="regex-head"><text>正则表达式</text><text>{{patternCount}} / {{maxPattern}}</text></view><view class="regex-pattern-input"><text>/</text><textarea value="{{pattern}}" bindinput="onPattern" maxlength="{{maxPattern}}" auto-height="{{true}}" placeholder="例如：\\b\\d{11}\\b" disable-default-padding="{{true}}" show-confirm-bar="{{false}}"></textarea><text>/{{flagsText}}</text></view></view>
  <view class="card regex-flags"><view class="regex-head"><text>匹配选项</text><text>可多选</text></view><view class="regex-flag-grid"><button wx:for="{{flagOptions}}" wx:key="key" class="{{item.active ? 'active' : ''}}" data-key="{{item.key}}" bindtap="toggleFlag"><text>{{item.title}} · {{item.key}}</text><text>{{item.desc}}</text></button></view></view>
  <view class="card regex-text"><view class="regex-head"><text>测试文本</text><text>{{textCount}} / {{maxText}}</text></view><textarea value="{{testText}}" bindinput="onText" maxlength="{{maxText}}" placeholder="输入或粘贴需要匹配的文本" disable-default-padding="{{true}}" show-confirm-bar="{{false}}" cursor-spacing="24"></textarea></view>
  <button class="primary-btn regex-main" bindtap="test">开始测试</button>
  <text wx:if="{{error}}" class="regex-error">{{error}}</text>
  <view wx:if="{{hasTested}}" class="card regex-results"><view class="regex-result-head"><view><text>匹配结果</text><text>{{matches.length}} 处</text></view><button bindtap="copyMatches">复制匹配项</button></view><scroll-view class="regex-highlight" scroll-y="{{true}}"><text wx:if="{{!matches.length}}" class="regex-empty">没有找到匹配内容</text><block wx:if="{{matches.length}}" wx:for="{{segments}}" wx:key="id"><text class="regex-segment {{item.type}}" selectable="{{true}}">{{item.text}}</text></block></scroll-view><text wx:if="{{truncated}}" class="regex-warning">匹配项超过 500 处，仅展示前 500 处。</text><view wx:if="{{matches.length}}" class="regex-match-list"><view wx:for="{{matches}}" wx:key="order" class="regex-match"><view class="regex-match-head"><text>#{{item.order}}</text><text>位置 {{item.range}}</text></view><text class="regex-match-value" selectable="{{true}}">{{item.display}}</text><view wx:if="{{item.groups.length}}" class="regex-groups"><text wx:for="{{item.groups}}" wx:key="index">组 {{item.index}}：{{item.value}}</text></view></view></view></view>
  <view class="regex-bottom"><button class="secondary-btn" bindtap="saveRecord" loading="{{saving}}">{{saved ? '已保存记录' : '保存记录'}}</button><button class="primary-btn" bindtap="clear">清空内容</button></view>
  <text class="regex-note">位置从 0 开始计算；仅点击“保存记录”后保留本次内容。</text>
  <view class="page-foot-tip"><view class="privacy-line"><image class="privacy-icon" src="/assets/icons/success.svg" mode="aspectFit"/><text class="privacy-copy">本地测试，输入内容不上传服务器</text></view></view>
</view>
