.mortgage-page { padding-bottom: 90rpx; }
.mortgage-page .tool-title { min-width: 0; padding-right: 12rpx; }
.mortgage-page .tool-icon { flex-shrink: 0; }
.loan-modes, .loan-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.loan-mode { box-sizing: border-box; position: relative; display: flex; align-items: center; justify-content: center; min-width: 0; min-height: 74rpx; padding: 12rpx 8rpx; border: 1px solid #D7E2EF; border-radius: 12rpx; color: #64768D; background: #FFFFFF; font-size: 24rpx; }
.loan-mode.active { color: #1768C5; border-color: #79ADF0; background: #EDF5FF; box-shadow: inset 0 0 0 1px #D5E6FA; font-weight: 600; }
.loan-panel { padding: 24rpx; margin-top: 20rpx; }
.loan-heading { display: block; color: var(--jt-navy); font-size: 27rpx; font-weight: 600; line-height: 1.5; }
.loan-heading-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; min-height: 58rpx; }
.loan-heading-row switch { flex-shrink: 0; }
.loan-field { min-width: 0; margin-top: 20rpx; }
.loan-field > text { display: block; margin-bottom: 12rpx; color: #66788E; font-size: 23rpx; line-height: 1.5; }
.loan-input { display: flex; align-items: center; gap: 10rpx; min-width: 0; height: 80rpx; padding: 0 16rpx; border: 1px solid #D5E1EE; border-radius: 12rpx; background: #FFFFFF; }
.loan-input input { box-sizing: border-box; flex: 1; min-width: 0; width: 0; height: 76rpx; font-size: 26rpx; color: #234666; }
.loan-input > text { flex-shrink: 0; color: #8191A4; font-size: 22rpx; }
.loan-hint { display: block; margin-top: 12rpx; color: #8191A4; font-size: 21rpx; line-height: 1.65; }
.loan-error { display: block; margin-top: 18rpx; color: #C84444; font-size: 23rpx; line-height: 1.6; }
.loan-main { margin-top: 22rpx; width: 100%; height: 88rpx; }
.loan-copy { display: flex; align-items: center; justify-content: center; gap: 6rpx; min-height: 58rpx; padding: 0 4rpx; flex-shrink: 0; color: #2F80ED; font-size: 22rpx; }
.loan-copy image { width: 26rpx; height: 26rpx; }
.loan-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20rpx 16rpx; margin-top: 18rpx; }
.loan-stats > view { min-width: 0; padding: 16rpx 12rpx; background: #F5F8FD; border-radius: 12rpx; }
.loan-stats text { display: block; font-size: 21rpx; color: #74849A; }
.loan-stats text + text { margin-top: 10rpx; color: #234666; font-size: 29rpx; font-weight: 600; overflow-wrap: anywhere; }
.loan-balance { margin-top: 24rpx; padding-top: 18rpx; border-top: 1rpx solid #E8EEF7; }
.loan-balance text { display: block; font-size: 22rpx; line-height: 1.8; color: #64768D; overflow-wrap: anywhere; }
.loan-plan { padding: 22rpx 18rpx; margin-top: 20rpx; background: #F4F9FF; border: 1px solid #DFEAF8; border-radius: 16rpx; }
.loan-saved { margin: 18rpx 0; }
.loan-saved > text { display: block; color: #5C7B9F; font-size: 22rpx; }
.loan-saved > text + text { margin-top: 8rpx; color: #2471CA; font-size: 38rpx; font-weight: 600; overflow-wrap: anywhere; }
.loan-unit { font-size: 22rpx; font-weight: 400; }
.loan-detail { display: flex; justify-content: space-between; align-items: flex-start; gap: 16rpx; padding: 12rpx 0; border-top: 1rpx solid #E0EAF6; font-size: 22rpx; line-height: 1.6; }
.loan-detail text:first-child { flex: 0 0 42%; color: #74849A; }
.loan-detail text:last-child { min-width: 0; text-align: right; color: #38536D; overflow-wrap: anywhere; }
.loan-table-modes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; margin-top: 18rpx; }
.loan-table-modes .loan-mode { font-size: 22rpx; min-height: 68rpx; }
.loan-table-scroll { width: 100%; margin-top: 18rpx; }
.loan-table { min-width: 880rpx; }
.loan-tr { display: grid; grid-template-columns: 60rpx repeat(3, minmax(0, 1fr)) minmax(0, 1.3fr); gap: 14rpx; min-height: 66rpx; padding: 14rpx 8rpx; align-items: center; border-bottom: 1rpx solid #E8EEF7; font-size: 22rpx; color: #38536D; font-variant-numeric: tabular-nums; }
.loan-tr text { text-align: right; }
.loan-tr text:first-child { text-align: left; }
.loan-th { background: #F5F8FC; color: #8191A4; }
.loan-more, .loan-clear { display: flex; align-items: center; justify-content: center; min-height: 76rpx; width: 100%; margin-top: 20rpx; color: #2F80ED; font-size: 24rpx; }
.loan-notes { margin-top: 18rpx; padding: 0 4rpx; color: #8191A4; font-size: 21rpx; line-height: 1.7; }
.loan-notes text { display: block; }
.loan-notes text:first-child { margin-bottom: 8rpx; font-weight: 600; }
