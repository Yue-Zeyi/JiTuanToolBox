.countdown-page { padding-bottom: 70rpx; }
.countdown-page .tool-title { min-width: 0; padding-right: 12rpx; }
.countdown-page .tool-icon { flex-shrink: 0; }
.timer-face { padding: 20rpx 24rpx 24rpx; text-align: center; }
.timer-ring { position: relative; width: 440rpx; max-width: 100%; height: 440rpx; margin: 0 auto; }
.timer-ring-image { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.timer-center { position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 16rpx; }
.timer-status { font-size: 25rpx; color: #6480A0; }
.timer-digits { font-size: 62rpx; line-height: 1.3; font-family: "SFMono-Regular", Consolas, monospace; font-variant-numeric: tabular-nums; font-weight: 600; letter-spacing: -1rpx; color: #21354B; white-space: nowrap; }
.timer-progress { font-size: 22rpx; color: #8191A4; }
.timer-done .timer-status { font-size: 30rpx; color: #228454; font-weight: 600; }
.timer-end { display: block; min-height: 36rpx; font-size: 23rpx; line-height: 1.6; color: #718096; }
.timer-dismiss { margin-top: 18rpx; height: 76rpx; }
.timer-actions { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: 16rpx; margin-top: 22rpx; }
.timer-actions button { width: 100%; min-width: 0; height: 88rpx; border-radius: 16rpx; font-size: 27rpx; }
.timer-panel { margin-top: 24rpx; padding: 24rpx; }
.timer-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; min-height: 50rpx; }
.timer-heading { font-size: 27rpx; font-weight: 600; color: #263A50; }
.timer-small { font-size: 20rpx; color: #8191A4; }
.timer-fields { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16rpx; margin-top: 18rpx; }
.timer-field { display: flex; align-items: center; gap: 6rpx; min-width: 0; height: 86rpx; padding: 0 16rpx; border: 1px solid #D5E1EE; border-radius: 12rpx; background: #FFFFFF; }
.timer-field input { box-sizing: border-box; flex: 1; min-width: 0; width: 0; height: 80rpx; text-align: center; color: #234666; font-size: 32rpx; font-family: Consolas, monospace; }
.timer-field text { flex-shrink: 0; font-size: 22rpx; color: #8191A4; }
.timer-presets { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; margin-top: 22rpx; }
.timer-preset { box-sizing: border-box; display: flex; align-items: center; justify-content: center; min-width: 0; min-height: 72rpx; padding: 12rpx 6rpx; border: 1px solid #D5E1EE; border-radius: 12rpx; color: #64768D; background: #FFFFFF; font-size: 22rpx; }
.timer-preset.active { color: #1768C5; border-color: #79ADF0; background: #EDF5FF; box-shadow: inset 0 0 0 1px #D5E6FA; }
.timer-hint { display: block; margin-top: 14rpx; color: #8191A4; font-size: 21rpx; line-height: 1.65; }
.timer-audio-test { color: #2F80ED; font-size: 23rpx; min-height: 58rpx; display: flex; align-items: center; padding: 0 4rpx; }
.timer-option { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 88rpx; border-bottom: 1rpx solid #E8EEF7; font-size: 24rpx; color: #64768D; }
.timer-option switch { flex-shrink: 0; }
.timer-error { display: block; margin-top: 16rpx; color: #B94B4B; font-size: 23rpx; line-height: 1.6; }
.timer-notes { padding: 0 4rpx; margin-top: 24rpx; color: #8191A4; font-size: 21rpx; line-height: 1.75; }
.timer-notes text { display: block; margin-top: 8rpx; }
.timer-notes text:first-child { font-weight: 600; font-size: 23rpx; }
