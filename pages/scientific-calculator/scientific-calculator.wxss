.scientific-page { padding-bottom: 90rpx; }
.scientific-segment { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8rpx; margin-top: 0; padding: 6rpx; border-radius: 14rpx; background: #E9EFF6; }
.scientific-mode { display: flex; align-items: center; justify-content: center; height: 68rpx; border: 1px solid transparent; border-radius: 10rpx; color: #718096; font-size: 23rpx; }
.scientific-mode.active { border-color: #C7DBF7; color: #1768C5; background: #FFFFFF; font-weight: 600; box-shadow: 0 3rpx 10rpx rgba(32, 75, 125, .08); }
.scientific-panel, .scientific-result { margin-top: 18rpx; padding: 24rpx; }
.scientific-panel-head, .scientific-result-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; color: var(--jt-navy); font-size: 27rpx; font-weight: 700; }
.scientific-panel-head text:last-child { color: #8794A7; font-size: 19rpx; font-weight: 400; }
.scientific-input { box-sizing: border-box; display: block; width: 100%; min-height: 132rpx; margin-top: 16rpx; padding: 17rpx; border: 1rpx solid #CBDCED; border-radius: 12rpx; color: #234666; background: #FFFFFF; font-family: Consolas, Monaco, monospace; font-size: 27rpx; line-height: 1.6; }
.scientific-placeholder { color: #9AA8BB; }
.scientific-keys { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 9rpx; margin-top: 14rpx; }
.scientific-key { display: flex; align-items: center; justify-content: center; min-width: 0; height: 58rpx; border: 1px solid #DCE5F1; border-radius: 10rpx; color: #516D8B; background: #F8FAFD; font-family: Consolas, Monaco, monospace; font-size: 20rpx; }
.scientific-edit-actions { display: flex; justify-content: flex-end; gap: 28rpx; margin-top: 18rpx; }
.scientific-edit-actions button { min-height: 52rpx; color: #2F80ED; font-size: 22rpx; }
.scientific-error { display: block; margin-top: 10rpx; color: #C84444; font-size: 22rpx; line-height: 1.5; }
.scientific-main { width: 100%; height: 84rpx; margin-top: 18rpx; border-radius: 14rpx; }
.scientific-result-head button { display: flex; align-items: center; gap: 7rpx; min-height: 52rpx; color: #2F80ED; font-size: 21rpx; font-weight: 400; }
.scientific-result-head image { width: 26rpx; height: 26rpx; }
.scientific-result-head button[disabled] { opacity: .4; }
.scientific-result-value { display: block; min-height: 76rpx; margin-top: 16rpx; color: #1768C5; font-family: Consolas, Monaco, monospace; font-size: 38rpx; line-height: 1.5; font-weight: 700; overflow-wrap: anywhere; }
.scientific-result-help { display: block; margin-top: 10rpx; color: #8794A7; font-size: 20rpx; line-height: 1.6; }
