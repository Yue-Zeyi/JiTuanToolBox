.hero { position: relative; display: flex; align-items: center; overflow: hidden; padding: 24rpx 28rpx 20rpx; min-height: 156rpx; background: linear-gradient(135deg, #2F80ED 0%, #4B93F4 58%, #5BA3FF 100%); color: #fff; border: 0; box-shadow: 0 14rpx 28rpx rgba(47, 128, 237, .18); }
.brand-line { display: flex; align-items: baseline; gap: 14rpx; }
.home-page .brand-icon { width: 80rpx; height: 80rpx; flex-shrink: 0; margin-left: 16rpx; }
.brand-count { color: #8A99AB; font-size: 20rpx; font-weight: 500; line-height: 1.3; white-space: nowrap; }
.hero-copy { position: relative; z-index: 2; width: 78%; transform: translateY(3rpx); }
.hero-title { display: block; font-size: 34rpx; font-weight: 700; line-height: 1.35; letter-spacing: -.4rpx; }
.hero-desc { display: block; margin-top: 14rpx; color: rgba(255, 255, 255, .88); font-size: 22rpx; line-height: 1.45; }
.hero-sheen { position: absolute; z-index: 1; top: -80%; left: -54%; width: 34%; height: 260%; transform: rotate(18deg); background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, .06) 35%, rgba(255, 255, 255, .24) 50%, rgba(255, 255, 255, 0) 68%); pointer-events: none; animation: hero-sweep 6.2s ease-in-out infinite; }
.hero-shape { position: absolute; z-index: 1; right: 28rpx; top: 50%; width: 110rpx; height: 110rpx; opacity: .46; transform: translateY(-50%) rotate(8deg); }
@keyframes hero-sweep { 0%, 12% { left: -54%; opacity: 0; } 22% { opacity: 1; } 46% { left: 118%; opacity: .84; } 58%, 100% { left: 118%; opacity: 0; } }
.tool-grid { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 18rpx 0; }
.tool-card { width: 48.5%; text-align: left; padding: 22rpx; min-height: 214rpx; }
.tool-card-top { display: flex; align-items: center; justify-content: space-between; }
.tool-card-badge { padding: 5rpx 9rpx; border-radius: 9rpx; color: #7B8BA2; background: #F1F4F8; font-size: 18rpx; line-height: 1.2; }
.tool-card-title { display: block; font-size: 29rpx; font-weight: 700; margin-top: 24rpx; }
.tool-card-desc { display: block; color: var(--jt-muted); font-size: 22rpx; line-height: 1.45; margin-top: 7rpx; }
.arrow { color: #A0AEC0; font-size: 34rpx; }
.more-tools { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); align-items: center; padding: 20rpx 8rpx; }
.more-item { width: 100%; min-width: 0; min-height: 92rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; color: var(--jt-muted); font-size: 22rpx; text-align: center; }
.more-item-label { display: block; width: 100%; padding: 0 4rpx; line-height: 1.25; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.recommend-refresh, .section-link-action { display: inline-flex; align-items: center; gap: 6rpx; min-height: 44rpx; padding: 4rpx 2rpx 4rpx 10rpx; color: var(--jt-primary); font-size: 24rpx; font-weight: 500; }
.recommend-refresh image, .section-link-action image { width: 28rpx; height: 28rpx; display: block; }
.mini-icon { width: 54rpx; height: 54rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; font-weight: 700; color: #fff; }
.mini-icon.green { background: #48C98A; }.mini-icon.purple { background: #8178E6; }.mini-icon.orange { background: #F2A04F; }.mini-icon.gray { background: #94A3B8; }.mini-icon.blue { background: #4F95F1; }
.recent { padding: 0 22rpx; }.recent-item { width: 100%; display: flex; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #F0F3F8; text-align: left; color: var(--jt-navy); font-size: 26rpx; }.recent-item:last-child { border-bottom: 0; }.recent-item text:nth-child(2) { flex: 1; margin-left: 16rpx; }.empty-recent { padding: 28rpx; text-align: center; color: var(--jt-muted); font-size: 23rpx; }.foot-note { color: #A0AEC0; text-align: center; font-size: 21rpx; margin: 22rpx 0; }
