.transform-page { padding-bottom: 110rpx; }
.transform-workspace, .transform-controls, .transform-result { padding: 24rpx; }
.transform-workspace { margin-top: 0; overflow: hidden; }
.transform-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; min-height: 310rpx; border: 2rpx dashed #B8D1F3; border-radius: 16rpx; background: #F8FBFF; color: var(--jt-navy); font-size: 27rpx; font-weight: 600; }
.transform-empty image { width: 72rpx; height: 72rpx; margin-bottom: 14rpx; }
.transform-empty text + text { margin-top: 8rpx; color: #8A9AB0; font-size: 20rpx; font-weight: 400; }
.transform-preview { display: flex; align-items: center; justify-content: center; width: 100%; height: 390rpx; overflow: hidden; border-radius: 14rpx; background: #F3F6FA; }
.transform-preview image { width: 78%; height: 78%; transition: transform .2s ease; }
.transform-meta { display: block; margin-top: 16rpx; color: #7D8EA4; font-size: 20rpx; line-height: 1.5; }
.transform-meta text:first-child { flex: 1; min-width: 0; overflow: hidden; color: var(--jt-navy); text-overflow: ellipsis; white-space: nowrap; }
.transform-meta text:last-child { display: block; margin-top: 4rpx; }
.transform-controls { margin-top: 18rpx; }
.transform-head { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; color: var(--jt-navy); font-size: 26rpx; font-weight: 600; }
.transform-head button { display: flex; align-items: center; justify-content: center; min-height: 52rpx; color: var(--jt-primary); font-size: 21rpx; line-height: 1; }
.transform-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; margin-top: 16rpx; }
.transform-grid.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.transform-grid button { display: flex; flex-direction: column; align-items: center; justify-content: center; min-width: 0; height: 98rpx; border: 1px solid #D8E3EF; border-radius: 12rpx; background: #FBFCFE; color: #61758E; font-size: 21rpx; }
.transform-grid button.active { border-color: #83B6F2; color: var(--jt-primary); background: #EEF6FF; box-shadow: inset 0 0 0 1rpx #D5E8FC; }
.transform-symbol { margin-bottom: 3rpx; color: var(--jt-primary); font-size: 34rpx; line-height: 1; }
.transform-divider { height: 1rpx; margin: 22rpx 0; background: #EDF1F6; }
.transform-label { color: var(--jt-navy); font-size: 25rpx; font-weight: 600; }
.transform-summary { display: block; margin-top: 16rpx; color: #8494A8; font-size: 20rpx; }
.transform-main { width: 100%; height: 86rpx; margin-top: 18rpx; border-radius: 14rpx; }
.transform-error { display: block; margin-top: 14rpx; color: #C84444; font-size: 22rpx; }
.transform-result { margin-top: 18rpx; }
.transform-done { color: #229A62; font-size: 21rpx; }
.transform-result > image { display: block; width: 100%; height: 380rpx; margin-top: 16rpx; border-radius: 14rpx; background: #F4F7FA; }
.transform-result-name { display: block; max-width: 100%; margin-top: 12rpx; overflow: hidden; color: var(--jt-navy); font-size: 22rpx; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.transform-result-meta { display: block; margin-top: 12rpx; color: var(--jt-muted); font-size: 21rpx; text-align: center; }
.transform-actions { display: grid; grid-template-columns: 1.4fr 1fr; gap: 12rpx; margin-top: 20rpx; }
.transform-actions button { width: 100%; height: 76rpx; border-radius: 13rpx; font-size: 23rpx; }
.hidden-canvas { position: fixed; left: -10000rpx; top: -10000rpx; width: 1px; height: 1px; opacity: 0; pointer-events: none; }

.transform-page .page-foot-tip { margin-top: 24rpx; }
.transform-page .privacy-line { align-items: center; }
.transform-page .privacy-copy, .transform-page .privacy-detail { text-align: center; }
